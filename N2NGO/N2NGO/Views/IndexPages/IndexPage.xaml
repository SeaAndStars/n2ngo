<local:BaseIndexPage 
    x:Class="N2NGO.Views.IndexPages.IndexPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.IndexPages"
    xmlns:utils="clr-namespace:N2NGO.Utils"
    xmlns:walterlv="clr-namespace:Walterlv.Windows.Effects;assembly=Walterlv.Themes.FluentDesign"
    mc:Ignorable="d" 
    TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified"
    d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
    Title="IndexPage" Loaded="Page_Loaded">
    <Grid>
        <hc:ScrollViewer x:Name="IndexersScrollViewer" hc:ScrollViewerAttach.Orientation="Horizontal" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Indexers" Margin="8,15,8,15" >
                <ItemsControl.Resources>
                    <local:IndexerTextConverter x:Key="IndexerTextConverter"/>
                    <utils:SolidColorBrushColorConverter x:Key="SolidColorBrushToColorConverter"/>
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Width="240" Height="470" BorderThickness="{DynamicResource RevealBorderThickness}" Visibility="{Binding Visibility}" Background="#1FB3B3B3" CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
            Initialized="Indexer_Initialized" MouseEnter="Indexer_MouseEnter" MouseLeave="Indexer_MouseLeave" MouseDown="Indexer_MouseDown" MouseUp="Indexer_MouseUp" MouseLeftButtonUp="Indexer_MouseLeftButtonUp">
                            <Border.BorderBrush>
                                <walterlv:RevealBorderBrush/>
                            </Border.BorderBrush>
                            <Grid>
                                <Image Name="ContentBackgroundImage" Opacity="0.5" Source="{Binding IndexerCBI}" Stretch="UniformToFill" Margin="25,250,0,0"/>
                                <TextBlock Margin="5" Foreground="{DynamicResource Palette_100}" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Run Name="_dynamicTextIndexerTitle" Text="{Binding IndexerTitle}" FontWeight="Bold" FontSize="34"/>
                                    <LineBreak/>
                                    <Run Name="_dynamicTextIndexerDescription" Text="{Binding IndexerDescription}" FontSize="16" Foreground="{DynamicResource Palette_50}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <Grid x:Name="ExtendIndexer2">
                    <Border x:Name="CurrentUserIndexer" BorderThickness="{DynamicResource RevealBorderThickness}" Margin="5,5,5,5" Width="180" Height="120" Background="#1FB3B3B3" CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
Initialized="Indexer_Initialized" MouseEnter="Indexer_MouseEnter" MouseLeave="Indexer_MouseLeave" MouseDown="Indexer_MouseDown" MouseUp="Indexer_MouseUp" MouseLeftButtonUp="Indexer_MouseLeftButtonUp" VerticalAlignment="Top">
                        <Border.DataContext>
                            <local:Indexer NagivKey="SetUserNickname"/>
                        </Border.DataContext>
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush/>
                        </Border.BorderBrush>
                        <Grid>
                            <TextBlock Margin="5" Foreground="{DynamicResource Palette_100}" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Run Text="{DynamicResource LOCALE_CurrentUser}" FontWeight="Bold" FontSize="34"/>
                                <LineBreak/>
                                <!--<hc:Gravatar x:Name="CurrentUserAvatar" Source="/Data/Images/Release.jpg" Height="80" Width="80"></hc:Gravatar>-->
                                <Run x:Name="CurrentUserNickname" Text="NewToGO" FontSize="16" Foreground="{DynamicResource Palette_50}"/>
                                <LineBreak/>
                                <Button Content="{DynamicResource LOCALE_ViewUserKey}" Click="ButtonViewKey_Click" Height="30"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="ExtendIndexer1">
                    <Border x:Name="CurrentServerIndexer" BorderThickness="{DynamicResource RevealBorderThickness}" Margin="5,5,5,5" Width="240" Height="230" Background="#1FB3B3B3" CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
Initialized="Indexer_Initialized" MouseEnter="Indexer_MouseEnter" MouseLeave="Indexer_MouseLeave" MouseDown="Indexer_MouseDown" MouseUp="Indexer_MouseUp" MouseLeftButtonUp="Indexer_MouseLeftButtonUp" VerticalAlignment="Top">
                        <Border.DataContext>
                            <local:Indexer NagivKey="ResetConnection"/>
                        </Border.DataContext>
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush/>
                        </Border.BorderBrush>
                        <Grid>
                            <TextBlock Margin="5" Foreground="{DynamicResource Palette_100}" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Run Text="{DynamicResource LOCALE_CurrentServer}" FontWeight="Bold" FontSize="34"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run x:Name="CurrentServerStatus" Text="Connected" FontSize="16" Foreground="{DynamicResource Palette_100}"/>
                                <Run Text=" • "/>
                                <Run x:Name="CurrentServerLatency" Text="1ms" FontSize="16" Foreground="{DynamicResource Palette_100}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run x:Name="CurrentServerOnlines" Text="0" FontSize="16" Foreground="{DynamicResource Palette_100}"/>
                                <Run Text="{DynamicResource LOCALE_Onlines}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Palette_50}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{DynamicResource LOCALE_Global}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Palette_50}"/>
                                <Run x:Name="CurrentServerGlobalAddress" Text="addr:port" FontSize="16" Foreground="{DynamicResource Palette_100}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource LOCALE_Supernode}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Palette_50}"/>
                                <Run x:Name="CurrentServerSupernodeAddress" Text="addr:port" FontSize="16" Foreground="{DynamicResource Palette_100}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border x:Name="CurrentRoomIndexer" BorderThickness="{DynamicResource RevealBorderThickness}" Margin="5,254,5,5" Width="240" Height="230" Background="#1FB3B3B3" CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
Initialized="Indexer_Initialized" MouseEnter="Indexer_MouseEnter" MouseLeave="Indexer_MouseLeave" MouseDown="Indexer_MouseDown" MouseUp="Indexer_MouseUp" MouseLeftButtonUp="Indexer_MouseLeftButtonUp" VerticalAlignment="Top">
                        <Border.DataContext>
                            <local:Indexer NagivKey="EnterRoom"/>
                        </Border.DataContext>
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush/>
                        </Border.BorderBrush>
                        <Grid>
                            <TextBlock Margin="5" Foreground="{DynamicResource Palette_100}" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Run Text="{DynamicResource LOCALE_CurrentRoom}" FontWeight="Bold" FontSize="34"/>
                                <LineBreak/>
                                <Run x:Name="CurrentRoomStatus" Text="{DynamicResource LOCALE_Status_Disconnected}" FontSize="16"/>
                                <LineBreak/>
                                <Run x:Name="CurrentRoomName" Text="{DynamicResource LOCALE_Unknown}" FontSize="16"/>
                                <LineBreak/>
                                <TextBlock Margin="5" Foreground="{DynamicResource Palette_100}" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Run Text="{DynamicResource LOCALE_CurrentRoomCode}" Foreground="{DynamicResource Palette_50}" FontWeight="Bold" FontSize="16"/>
                                    <Run x:Name="CurrentRoomCode" Text="abcdef" FontSize="14"/>
                                    <LineBreak/>
                                    <Run Text="{DynamicResource LOCALE_CurrentRoomPasswordNeeded}" Foreground="{DynamicResource Palette_50}" FontWeight="Bold" FontSize="16"/>
                                    <Run x:Name="CurrentRoomPasswordNeeded" Text="{DynamicResource LOCALE_CurrentRoomPasswordNeeded_No}" FontSize="14"/>
                                    <LineBreak/>
                                    <Run Text="{DynamicResource LOCALE_CurrentRoomVisibility}" Foreground="{DynamicResource Palette_50}" FontWeight="Bold" FontSize="16"/>
                                    <Run x:Name="CurrentRoomVisibility" Text="{DynamicResource LOCALE_CurrentRoomVisibility_Invisible}" FontSize="14"/>
                                    <LineBreak/>
                                </TextBlock>
                                <LineBreak/>
                                <Run Text="{DynamicResource LOCALE_CreateRoomMyIP}" FontSize="12"/>
                                <Run x:Name="CurrentRoomIpAddress" Text="{DynamicResource LOCALE_Unknown}" FontSize="16"/>
                                <LineBreak/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
                <local:Indexer NagivKey="Community"  IndexerTitle="@LOCALE_Index-Community_Title" IndexerDescription="@LOCALE_Index-Community_Description" IndexerCBI="/Data/Images/Community.png"/>
                <local:Indexer NagivKey="Hosting" IndexerTitle="@LOCALE_Index-Hosting_Title" IndexerDescription="@LOCALE_Index-Hosting_Description" IndexerCBI="/Data/Images/Hosting.png"/>
                <local:Indexer NagivKey="Clienting" IndexerTitle="@LOCALE_Index-Clienting_Title" IndexerDescription="@LOCALE_Index-Clienting_Description" IndexerCBI="/Data/Images/Clienting.png"/>
                <local:Indexer NagivKey="Advanced" IndexerTitle="@LOCALE_Index-Advanced_Title" IndexerDescription="@LOCALE_Index-Advanced_Description" IndexerCBI="/Data/Images/Advanced.png"/>
                <local:Indexer NagivKey="About" IndexerTitle="@LOCALE_Index-About_Title" IndexerDescription="@LOCALE_Index-About_Description" IndexerCBI="/Data/Images/About.png"/>
            </ItemsControl>
        </hc:ScrollViewer>
    </Grid>
</local:BaseIndexPage>
