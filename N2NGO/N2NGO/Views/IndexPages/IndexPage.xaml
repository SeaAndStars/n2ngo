<local:BaseIndexPage
    x:Class="N2NGO.Views.IndexPages.IndexPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.IndexPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:utils="clr-namespace:N2NGO.Utils"
    xmlns:walterlv="clr-namespace:Walterlv.Windows.Effects;assembly=Walterlv.Themes.FluentDesign"
    Title="IndexPage"
    d:DesignHeight="{StaticResource PageDesignHeight}"
    d:DesignWidth="{StaticResource PageDesignWidth}"
    FontFamily="{DynamicResource MainFont}"
    Loaded="Page_Loaded"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">
    <Grid>
        <hc:ScrollViewer
            x:Name="IndexersScrollViewer"
            hc:ScrollViewerAttach.Orientation="Horizontal"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Indexers" Margin="8,15,8,15">
                <ItemsControl.Resources>
                    <local:IndexerTextConverter x:Key="IndexerTextConverter" />
                    <utils:SolidColorBrushColorConverter x:Key="SolidColorBrushToColorConverter" />
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="240"
                            Height="470"
                            Margin="5"
                            Background="#1FB3B3B3"
                            BorderThickness="{DynamicResource RevealBorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                            Initialized="Indexer_Initialized"
                            MouseDown="Indexer_MouseDown"
                            MouseEnter="Indexer_MouseEnter"
                            MouseLeave="Indexer_MouseLeave"
                            MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                            MouseUp="Indexer_MouseUp"
                            Visibility="{Binding Visibility}">
                            <Border.BorderBrush>
                                <walterlv:RevealBorderBrush />
                            </Border.BorderBrush>
                            <Grid>
                                <Image
                                    Name="ContentBackgroundImage"
                                    Margin="25,250,0,0"
                                    Opacity="0.5"
                                    Source="{Binding IndexerCBI}"
                                    Stretch="UniformToFill" />
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Foreground="{DynamicResource Palette_100}"
                                    TextWrapping="Wrap">
                                    <Run
                                        Name="_dynamicTextIndexerTitle"
                                        FontSize="34"
                                        FontWeight="Bold"
                                        Text="{Binding IndexerTitle}" />
                                    <LineBreak />
                                    <Run
                                        Name="_dynamicTextIndexerDescription"
                                        FontSize="16"
                                        Foreground="{DynamicResource Palette_50}"
                                        Text="{Binding IndexerDescription}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <Grid x:Name="ExtendIndexer2">
                    <Border
                        x:Name="CurrentUserIndexer"
                        Width="180"
                        Height="120"
                        Margin="5,5,5,5"
                        VerticalAlignment="Top"
                        Background="#1FB3B3B3"
                        BorderThickness="{DynamicResource RevealBorderThickness}"
                        CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                        Initialized="Indexer_Initialized"
                        MouseDown="Indexer_MouseDown"
                        MouseEnter="Indexer_MouseEnter"
                        MouseLeave="Indexer_MouseLeave"
                        MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                        MouseUp="Indexer_MouseUp">
                        <Border.DataContext>
                            <local:Indexer NagivKey="SetUserNickname" />
                        </Border.DataContext>
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush />
                        </Border.BorderBrush>
                        <Grid>
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Foreground="{DynamicResource Palette_100}"
                                TextWrapping="Wrap">
                                <Run
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Text="{DynamicResource LOCALE_CurrentUser}" />
                                <LineBreak />
                                <!--<hc:Gravatar x:Name="CurrentUserAvatar" Source="/Data/Images/Release.jpg" Height="80" Width="80"></hc:Gravatar>-->
                                <Run
                                    x:Name="CurrentUserNickname"
                                    FontSize="16"
                                    Foreground="{DynamicResource Palette_50}"
                                    Text="NewToGO" />
                                <LineBreak />
                                <Button
                                    Height="30"
                                    Click="ButtonViewKey_Click"
                                    Content="{DynamicResource LOCALE_ViewUserKey}" />
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="ExtendIndexer1">
                    <Border
                        x:Name="CurrentServerIndexer"
                        Width="240"
                        Height="230"
                        Margin="5,5,5,5"
                        VerticalAlignment="Top"
                        Background="#1FB3B3B3"
                        BorderThickness="{DynamicResource RevealBorderThickness}"
                        CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                        Initialized="Indexer_Initialized"
                        MouseDown="Indexer_MouseDown"
                        MouseEnter="Indexer_MouseEnter"
                        MouseLeave="Indexer_MouseLeave"
                        MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                        MouseUp="Indexer_MouseUp">
                        <Border.DataContext>
                            <local:Indexer NagivKey="ResetConnection" />
                        </Border.DataContext>
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush />
                        </Border.BorderBrush>
                        <Grid>
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Foreground="{DynamicResource Palette_100}"
                                TextWrapping="Wrap">
                                <Run
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Text="{DynamicResource LOCALE_CurrentServer}" />
                                <LineBreak />
                                <LineBreak />
                                <Run
                                    x:Name="CurrentServerStatus"
                                    FontSize="16"
                                    Foreground="{DynamicResource Palette_100}"
                                    Text="Connected" />
                                <Run Text=" • " />
                                <Run
                                    x:Name="CurrentServerLatency"
                                    FontSize="16"
                                    Foreground="{DynamicResource Palette_100}"
                                    Text="1ms" />
                                <LineBreak />
                                <LineBreak />
                                <Run
                                    x:Name="CurrentServerOnlines"
                                    FontSize="16"
                                    Foreground="{DynamicResource Palette_100}"
                                    Text="0" />
                                <Run
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Palette_50}"
                                    Text="{DynamicResource LOCALE_Onlines}" />
                                <LineBreak />
                                <LineBreak />
                                <Run
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Palette_50}"
                                    Text="{DynamicResource LOCALE_Global}" />
                                <Run
                                    x:Name="CurrentServerGlobalAddress"
                                    FontSize="16"
                                    Foreground="{DynamicResource Palette_100}"
                                    Text="addr:port" />
                                <LineBreak />
                                <Run
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Palette_50}"
                                    Text="{DynamicResource LOCALE_Supernode}" />
                                <Run
                                    x:Name="CurrentServerSupernodeAddress"
                                    FontSize="16"
                                    Foreground="{DynamicResource Palette_100}"
                                    Text="addr:port" />
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="CurrentRoomIndexer"
                        Width="240"
                        Height="230"
                        Margin="5,254,5,5"
                        VerticalAlignment="Top"
                        Background="#1FB3B3B3"
                        BorderThickness="{DynamicResource RevealBorderThickness}"
                        CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                        Initialized="Indexer_Initialized"
                        MouseDown="Indexer_MouseDown"
                        MouseEnter="Indexer_MouseEnter"
                        MouseLeave="Indexer_MouseLeave"
                        MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                        MouseUp="Indexer_MouseUp">
                        <Border.DataContext>
                            <local:Indexer NagivKey="EnterRoom" />
                        </Border.DataContext>
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush />
                        </Border.BorderBrush>
                        <Grid>
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Foreground="{DynamicResource Palette_100}"
                                TextWrapping="Wrap">
                                <Run
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Text="{DynamicResource LOCALE_CurrentRoom}" />
                                <LineBreak />
                                <Run
                                    x:Name="CurrentRoomStatus"
                                    FontSize="16"
                                    Text="{DynamicResource LOCALE_Status_Disconnected}" />
                                <LineBreak />
                                <Run
                                    x:Name="CurrentRoomName"
                                    FontSize="16"
                                    Text="{DynamicResource LOCALE_Unknown}" />
                                <LineBreak />
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Foreground="{DynamicResource Palette_100}"
                                    TextWrapping="Wrap">
                                    <Run
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Palette_50}"
                                        Text="{DynamicResource LOCALE_CurrentRoomCode}" />
                                    <Run
                                        x:Name="CurrentRoomCode"
                                        FontSize="14"
                                        Text="abcdef" />
                                    <LineBreak />
                                    <Run
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Palette_50}"
                                        Text="{DynamicResource LOCALE_CurrentRoomPasswordNeeded}" />
                                    <Run
                                        x:Name="CurrentRoomPasswordNeeded"
                                        FontSize="14"
                                        Text="{DynamicResource LOCALE_CurrentRoomPasswordNeeded_No}" />
                                    <LineBreak />
                                    <Run
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Palette_50}"
                                        Text="{DynamicResource LOCALE_CurrentRoomVisibility}" />
                                    <Run
                                        x:Name="CurrentRoomVisibility"
                                        FontSize="14"
                                        Text="{DynamicResource LOCALE_CurrentRoomVisibility_Invisible}" />
                                    <LineBreak />
                                </TextBlock>
                                <LineBreak />
                                <Run FontSize="12" Text="{DynamicResource LOCALE_CreateRoomMyIP}" />
                                <Run
                                    x:Name="CurrentRoomIpAddress"
                                    FontSize="16"
                                    Text="{DynamicResource LOCALE_Unknown}" />
                                <LineBreak />
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
                <local:Indexer
                    IndexerCBI="/Data/Images/Community.png"
                    IndexerDescription="@LOCALE_Index-Community_Description"
                    IndexerTitle="@LOCALE_Index-Community_Title"
                    NagivKey="Community" />
                <local:Indexer
                    IndexerCBI="/Data/Images/Hosting.png"
                    IndexerDescription="@LOCALE_Index-Hosting_Description"
                    IndexerTitle="@LOCALE_Index-Hosting_Title"
                    NagivKey="Hosting" />
                <local:Indexer
                    IndexerCBI="/Data/Images/Clienting.png"
                    IndexerDescription="@LOCALE_Index-Clienting_Description"
                    IndexerTitle="@LOCALE_Index-Clienting_Title"
                    NagivKey="Clienting" />
                <local:Indexer
                    IndexerCBI="/Data/Images/Advanced.png"
                    IndexerDescription="@LOCALE_Index-Advanced_Description"
                    IndexerTitle="@LOCALE_Index-Advanced_Title"
                    NagivKey="Advanced" />
                <local:Indexer
                    IndexerCBI="/Data/Images/About.png"
                    IndexerDescription="@LOCALE_Index-About_Description"
                    IndexerTitle="@LOCALE_Index-About_Title"
                    NagivKey="About" />
            </ItemsControl>
        </hc:ScrollViewer>
    </Grid>
</local:BaseIndexPage>
