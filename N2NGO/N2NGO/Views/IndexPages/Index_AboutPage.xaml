<local:BaseIndexPage
    x:Class="N2NGO.Views.IndexPages.Index_AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.IndexPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:utils="clr-namespace:N2NGO.Utils"
    xmlns:walterlv="clr-namespace:Walterlv.Windows.Effects;assembly=Walterlv.Themes.FluentDesign"
    Title="Index_AboutPage"
    d:DesignHeight="{StaticResource PageDesignHeight}"
    d:DesignWidth="{StaticResource PageDesignWidth}"
    FontFamily="{DynamicResource MainFont}"
    Loaded="Page_Loaded"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <Grid>
        <Image Source="/Data/Images/About.png" Style="{DynamicResource IndexPageBackgroundImage}" />

        <hc:ScrollViewer
            hc:ScrollViewerAttach.Orientation="Horizontal"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Indexers" Margin="8,15,8,15">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="240"
                            Height="480"
                            Margin="5"
                            Background="#1FB3B3B3"
                            BorderThickness="{DynamicResource RevealBorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                            Initialized="Indexer_Initialized"
                            MouseDown="Indexer_MouseDown"
                            MouseEnter="Indexer_MouseEnter"
                            MouseLeave="Indexer_MouseLeave"
                            MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                            MouseUp="Indexer_MouseUp"
                            Visibility="{Binding Visibility}">
                            <Border.BorderBrush>
                                <walterlv:RevealBorderBrush />
                            </Border.BorderBrush>
                            <Grid>
                                <Image
                                    Name="ContentBackgroundImage"
                                    Margin="25,250,0,0"
                                    Opacity="0.5"
                                    Source="{Binding IndexerCBI}"
                                    Stretch="UniformToFill" />
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Foreground="{DynamicResource Palette_100}"
                                    TextWrapping="Wrap">
                                    <Run
                                        Name="_dynamicIndexerTitle"
                                        FontSize="34"
                                        FontWeight="Bold"
                                        Text="{Binding IndexerTitle}" />
                                    <LineBreak />
                                    <Run
                                        Name="_dynamicTextIndexerDescription"
                                        FontSize="16"
                                        Foreground="{DynamicResource Palette_50}"
                                        Text="{Binding IndexerDescription}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <local:Indexer
                    IndexerDescription="@LOCALE_Index-GoBack_Description"
                    IndexerTitle="@LOCALE_Index-GoBack_Title"
                    NagivKey="goback" />
                <local:Indexer IndexerDescription="@LOCALE_Index_AboutPage-AboutUs_Description" IndexerTitle="@LOCALE_Index_AboutPage-AboutUs_Title" />
            </ItemsControl>
        </hc:ScrollViewer>
    </Grid>
</local:BaseIndexPage>
