<local:BaseIndexPage
    x:Class="N2NGO.Views.IndexPages.Index_StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.IndexPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:utils="clr-namespace:N2NGO.Utils"
    xmlns:walterlv="clr-namespace:Walterlv.Windows.Effects;assembly=Walterlv.Themes.FluentDesign"
    Title="Index_AdvancedPage"
    d:DesignHeight="{StaticResource PageDesignHeight}"
    d:DesignWidth="{StaticResource PageDesignWidth}"
    FontFamily="{DynamicResource MainFont}"
    Loaded="Page_Loaded"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <Grid>
        <Image Source="/Data/Images/Advanced.png" Style="{DynamicResource IndexPageBackgroundImage}" />

        <hc:ScrollViewer
            hc:ScrollViewerAttach.Orientation="Horizontal"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Indexers" Margin="8,15,8,15">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="240"
                            Height="480"
                            Margin="5"
                            Background="#1FB3B3B3"
                            BorderThickness="{DynamicResource RevealBorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                            Initialized="Indexer_Initialized"
                            MouseDown="Indexer_MouseDown"
                            MouseEnter="Indexer_MouseEnter"
                            MouseLeave="Indexer_MouseLeave"
                            MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                            MouseUp="Indexer_MouseUp"
                            Visibility="{Binding Visibility}">
                            <Border.BorderBrush>
                                <walterlv:RevealBorderBrush Color="#FFB92FD0" />
                            </Border.BorderBrush>
                            <Grid>
                                <Image
                                    Name="ContentBackgroundImage"
                                    Margin="25,250,0,0"
                                    Opacity="0.5"
                                    Source="{Binding IndexerCBI}"
                                    Stretch="UniformToFill" />
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Foreground="{DynamicResource Palette_100}"
                                    TextWrapping="Wrap">
                                    <Run
                                        Name="_dynamicIndexerTitle"
                                        FontSize="34"
                                        FontWeight="Bold"
                                        Text="{Binding IndexerTitle}" />
                                    <LineBreak />
                                    <Run
                                        Name="_dynamicTextIndexerDescription"
                                        FontSize="16"
                                        Foreground="{DynamicResource Palette_50}"
                                        Text="{Binding IndexerDescription}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>


                <local:Indexer
                    IndexerDescription="@LOCALE_Index-GoBack_Description"
                    IndexerTitle="@LOCALE_Index-GoBack_Title"
                    NagivKey="goback" />
                <Grid RenderTransformOrigin="0,0.5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Width="180"
                        Height="84"
                        Margin="5,5,5,5"
                        HorizontalAlignment="Left"
                        Background="#1FB3B3B3"
                        BorderThickness="{DynamicResource RevealBorderThickness}"
                        CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                        Initialized="Indexer_Initialized"
                        MouseDown="Indexer_MouseDown"
                        MouseEnter="Indexer_MouseEnter"
                        MouseLeave="Indexer_MouseLeave"
                        MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                        MouseUp="Indexer_MouseUp">
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush Color="#FF66A1FF" />
                        </Border.BorderBrush>
                        <Border.DataContext>
                            <local:Indexer NagivKey="RefreshStorageAll" />
                        </Border.DataContext>
                        <Grid>
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Foreground="{DynamicResource Palette_100}"
                                TextWrapping="Wrap">
                                <Run
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Text="{DynamicResource LOCALE_AppGlobalStorageUsage}" />
                                <LineBreak />
                                <Run
                                    x:Name="StorageTotalUsage"
                                    FontSize="24"
                                    Foreground="{DynamicResource Palette_50}"
                                    Text="0B" />
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Width="345"
                        Height="115"
                        Margin="5,5,5,5"
                        HorizontalAlignment="Left"
                        Background="#1FB3B3B3"
                        BorderThickness="{DynamicResource RevealBorderThickness}"
                        CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                        Initialized="Indexer_Initialized"
                        MouseDown="Indexer_MouseDown"
                        MouseEnter="Indexer_MouseEnter"
                        MouseLeave="Indexer_MouseLeave"
                        MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                        MouseUp="Indexer_MouseUp">
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush Color="#FFFF8000" />
                        </Border.BorderBrush>
                        <Border.DataContext>
                            <local:Indexer NagivKey="RefreshStorageAll" />
                        </Border.DataContext>
                        <Grid>
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Foreground="{DynamicResource Palette_100}"
                                TextWrapping="Wrap">
                                <Run
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Text="{DynamicResource LOCALE_AppProgramFilesStorageUsage}" />
                                <LineBreak />
                                <Run
                                    x:Name="StorageProgramFilesUsage"
                                    FontSize="16"
                                    Foreground="{DynamicResource Palette_50}"
                                    Text="0B" />
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="2"
                        Width="320"
                        Height="115"
                        Margin="5,5,5,5"
                        HorizontalAlignment="Left"
                        Background="#1FB3B3B3"
                        BorderThickness="{DynamicResource RevealBorderThickness}"
                        CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                        Initialized="Indexer_Initialized"
                        MouseDown="Indexer_MouseDown"
                        MouseEnter="Indexer_MouseEnter"
                        MouseLeave="Indexer_MouseLeave"
                        MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                        MouseUp="Indexer_MouseUp">
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush Color="#FF00FF1B" />
                        </Border.BorderBrush>
                        <Border.DataContext>
                            <local:Indexer NagivKey="RefreshStorageAll" />
                        </Border.DataContext>
                        <Grid>
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Foreground="{DynamicResource Palette_100}"
                                TextWrapping="Wrap">
                                <Run
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Text="{DynamicResource LOCALE_AppDataFilesStorageUsage}" />
                                <LineBreak />
                                <Run
                                    x:Name="StorageDataFilesUsage"
                                    FontSize="16"
                                    Foreground="{DynamicResource Palette_50}"
                                    Text="Item 0B" />
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="3"
                        Width="380"
                        Height="115"
                        Margin="5,5,5,5"
                        HorizontalAlignment="Left"
                        Background="#1FB3B3B3"
                        BorderThickness="{DynamicResource RevealBorderThickness}"
                        CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
                        Initialized="Indexer_Initialized"
                        MouseDown="Indexer_MouseDown"
                        MouseEnter="Indexer_MouseEnter"
                        MouseLeave="Indexer_MouseLeave"
                        MouseLeftButtonUp="Indexer_MouseLeftButtonUp"
                        MouseUp="Indexer_MouseUp">
                        <Border.BorderBrush>
                            <walterlv:RevealBorderBrush Color="#FFC76DD6" />
                        </Border.BorderBrush>
                        <Border.DataContext>
                            <local:Indexer NagivKey="RefreshStorageAll" />
                        </Border.DataContext>
                        <Grid>
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Foreground="{DynamicResource Palette_100}"
                                TextWrapping="Wrap">
                                <Run
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="{DynamicResource LOCALE_AppOtherDataFilesStorageUsage}" />
                                <LineBreak />
                                <Run
                                    x:Name="StorageOtherDataFilesUsage"
                                    FontSize="16"
                                    Foreground="{DynamicResource Palette_50}"
                                    Text="Item 0B" />
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </ItemsControl>
        </hc:ScrollViewer>
    </Grid>
</local:BaseIndexPage>
