<Page
    x:Class="N2NGO.Views.SubPages.Dialogs.DialogLoading"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.SubPages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DialogRoomInfo"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{DynamicResource MainFont}"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">
    <Grid
        x:Name="Root"
        Margin="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#3F000000">
        <hc:LoadingCircle
            Margin="0,-30,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource Palette_400}" />
        <Label
            x:Name="LabelContent"
            Margin="0,50,0,0"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="{DynamicResource MainColorSolidAlphaBrush}"
            BorderBrush="{x:Null}"
            FontSize="16"
            Foreground="{DynamicResource MainColorSolidFontBrush}" />
        <Button
            x:Name="ButtonAction"
            Margin="0,160,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
