<Page
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N2NGO.Views.SubPages.Dialogs"
        xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="N2NGO.Views.SubPages.Dialogs.DialogLoading"
        mc:Ignorable="d"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified"
        d:DesignHeight="450" d:DesignWidth="800" FontFamily="{DynamicResource MainFont}"
        Title="DialogRoomInfo">
    <Grid x:Name="Root" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#3F000000">
        <hc:LoadingCircle Foreground="{DynamicResource Palette_400}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0"/>
        <Label x:Name="LabelContent" VerticalContentAlignment="Center" Background="{DynamicResource MainColorSolidAlphaBrush}" HorizontalContentAlignment="Center" Foreground="{DynamicResource MainColorSolidFontBrush}" Margin="0,50,0,0" BorderBrush="{x:Null}" VerticalAlignment="Center" FontSize="16" />
        <Button x:Name="ButtonAction" HorizontalAlignment="Center" Margin="0,160,0,0" VerticalAlignment="Center"/>
    </Grid>
</Page>
