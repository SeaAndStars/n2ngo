<Window
    x:Class="N2NGO.Views.SubPages.Dialogs.DialogImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:N2NGO.Views.SubPages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DialogImageView"
    Width="400"
    Height="300"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">
    <Window.Background>
        <LinearGradientBrush>
            <GradientStop Color="Red" />
            <GradientStop Offset="0.167" Color="Magenta" />
            <GradientStop Offset="0.334" Color="Blue" />
            <GradientStop Offset="0.501" Color="Cyan" />
            <GradientStop Offset="0.668" Color="Lime" />
            <GradientStop Offset="0.835" Color="Yellow" />
            <GradientStop Offset="1" Color="Red" />
        </LinearGradientBrush>
    </Window.Background>
    <Image x:Name="ImageBox" Stretch="None" />
</Window>
