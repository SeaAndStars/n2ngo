<Page
    x:Class="N2NGO.Views.SubPages.Dialogs.MessageDialogs.DialogInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.SubPages.Dialogs.MessageDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Input"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{DynamicResource MainFont}"
    Foreground="{DynamicResource MainColorSolidFontBrush}"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <Grid Margin="5,0,5,0">
        <hc:ScrollViewer Margin="0,0,0,110">
            <TextBlock
                x:Name="MessageContentRunner"
                Padding="5,2,5,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource MainColorSolidAlphaBrush}"
                FontSize="17.5"
                TextWrapping="Wrap" />
        </hc:ScrollViewer>

        <TextBox
            x:Name="InputBox"
            Height="44"
            MinWidth="120"
            Margin="0,0,0,60"
            Padding="10,6,13,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            HorizontalContentAlignment="Center"
            Background="{DynamicResource MainColorSolidAlphaBrush}"
            BorderBrush="{x:Null}"
            Effect="{StaticResource EffectShadow2}"
            FontSize="20"
            Foreground="{DynamicResource MainColorSolidFontBrush}"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto" />
        <Button
            x:Name="ButtonOK"
            Height="36"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Content="{DynamicResource LOCALE_Dialog_InputOKButton}"
            FontSize="18" />
    </Grid>
</Page>
