<Page x:Class="N2NGO.Views.SubPages.Dialogs.MessageDialogs.DialogOK"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:local="clr-namespace:N2NGO.Views.SubPages.Dialogs.MessageDialogs"
      mc:Ignorable="d" 
      TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OK" Foreground="{DynamicResource MainColorSolidFontBrush}">

    <Grid>
        <hc:ScrollViewer Margin="0,0,0,65">
            <TextBlock x:Name="MessageContentRunner" TextWrapping="Wrap" FontSize="17.5" Padding="5,2,5,0" Background="{DynamicResource MainColorSolidAlphaBrush}"/>
        </hc:ScrollViewer>
        <Button x:Name="ButtonOK" Width="90" VerticalAlignment="Bottom" Content="{DynamicResource LOCALE_Dialog_OKButton}" HorizontalAlignment="Center" FontSize="18" Height="36" Margin="0,0,0,20"/>
    </Grid>
</Page>
