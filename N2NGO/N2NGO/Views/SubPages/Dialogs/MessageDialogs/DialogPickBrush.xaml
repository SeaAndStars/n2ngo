<Page
    x:Class="N2NGO.Views.SubPages.Dialogs.MessageDialogs.DialogPickBrush"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.SubPages.Dialogs.MessageDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PickBrush"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{DynamicResource MainFont}"
    Foreground="{DynamicResource MainColorSolidFontBrush}"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <Grid>
        <hc:ScrollViewer Margin="0,0,0,65">
            <TextBlock
                Padding="5,2,5,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource MainColorSolidAlphaBrush}"
                FontSize="14"
                TextWrapping="Wrap">
                <TextBlock x:Name="MessageContentRunner" FontSize="18" />
                <LineBreak />
                <Rectangle
                    x:Name="PreviewColor"
                    Width="50"
                    Height="50"
                    Effect="{StaticResource EffectShadow2}"
                    Fill="{Binding}">
                    <Rectangle.DataContext>
                        <SolidColorBrush Color="#FFFFFFFF" />
                    </Rectangle.DataContext>
                </Rectangle>
                <LineBreak />
                <LineBreak />
                <Run Text="ARGB:" />
                <LineBreak />
                <TextBox
                    x:Name="ColorAlphaInput"
                    Background="{DynamicResource MainColorSolidAlphaBrush}"
                    BorderBrush="{x:Null}"
                    Foreground="{DynamicResource MainColorSolidFontBrush}"
                    Text="255"
                    TextChanged="ColorInput_TextChanged" />
                <TextBox
                    x:Name="ColorRedInput"
                    Background="{DynamicResource MainColorSolidAlphaBrush}"
                    BorderBrush="{x:Null}"
                    Foreground="{DynamicResource MainColorSolidFontBrush}"
                    Text="255"
                    TextChanged="ColorInput_TextChanged" />
                <TextBox
                    x:Name="ColorGreenInput"
                    Background="{DynamicResource MainColorSolidAlphaBrush}"
                    BorderBrush="{x:Null}"
                    Foreground="{DynamicResource MainColorSolidFontBrush}"
                    Text="255"
                    TextChanged="ColorInput_TextChanged" />
                <TextBox
                    x:Name="ColorBlueInput"
                    Background="{DynamicResource MainColorSolidAlphaBrush}"
                    BorderBrush="{x:Null}"
                    Foreground="{DynamicResource MainColorSolidFontBrush}"
                    Text="255"
                    TextChanged="ColorInput_TextChanged" />
            </TextBlock>
        </hc:ScrollViewer>
        <Button
            x:Name="ButtonDone"
            Height="36"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Content="Done"
            FontSize="18" />
    </Grid>
</Page>
