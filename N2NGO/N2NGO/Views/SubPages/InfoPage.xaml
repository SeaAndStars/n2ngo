<Page
    x:Class="N2NGO.Views.SubPages.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:N2NGO.Views.SubPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="InfoPage"
    d:DesignHeight="{StaticResource PageDesignHeight}"
    d:DesignWidth="{StaticResource PageDesignWidth}"
    FontFamily="{DynamicResource MainFont}"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">
    <Grid>
        <Canvas x:Name="N2NGO_Warpper_C">
            <Image
                x:Name="N2NGO_Warpper"
                Width="865"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="/Data/Images/N2NGO_Logo_Warpper.png" />
        </Canvas>
        <Canvas x:Name="N2NGO_N2N_Border_C">
            <Image
                x:Name="N2NGO_N2N_Border"
                Width="865"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="/Data/Images/N2NGO_Logo_N2N_Border.png" />
        </Canvas>
        <Canvas x:Name="N2NGO_N2N_C">
            <Image
                x:Name="N2NGO_N2N"
                Width="865"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="/Data/Images/N2NGO_Logo_N2N.png" />
        </Canvas>
        <Canvas x:Name="N2NGO_GO_C">
            <Image
                x:Name="N2NGO_GO"
                Width="865"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="/Data/Images/N2NGO_Logo_GO.png" />
        </Canvas>

        <TextBlock
            x:Name="N2NGO_base"
            Width="844"
            Height="92"
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">
            <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF484848" />
                    <GradientStop Offset="1" Color="White" />
                    <GradientStop Offset="0.74" Color="White" />
                </LinearGradientBrush>
            </TextBlock.Foreground>

            <Run FontSize="68">N2N GO</Run>
            <Run FontSize="10">Ver. 4.0.0</Run>
        </TextBlock>

        <TextBlock
            x:Name="N2NGO_Link"
            Margin="33,90,33,118"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="18">
            <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Offset="1" Color="#FF484848" />
                    <GradientStop Offset="0" Color="White" />
                    <GradientStop Offset="0.26" Color="White" />
                </LinearGradientBrush>
            </TextBlock.Foreground>
            <Run>GPL3.0</Run>
            <Image Width="15" Source="/Data/Images/logo13.ico" /> <Run
                MouseUp="Run_N2NGO_gitee"
                Style="{DynamicResource RunLink}"
                Text="https://gitee.com/xue-jiangbin/n2nmc" />
            <LineBreak />
        </TextBlock>

        <TextBlock
            x:Name="N2NGO_info"
            Width="843"
            Height="87"
            Margin="11,0,11,0"
            Padding="5,5,5,5"
            VerticalAlignment="Bottom"
            Background="{DynamicResource MainColorSolidAlphaBrush}"
            FontSize="18"
            Foreground="{DynamicResource MainColorSolidFontBrush}">
            <Run>始创：</Run> <Run MouseUp="Run_未来之乡_gitee" Style="{DynamicResource RunLink}">@未来之乡 (Gitee)</Run>
            <LineBreak />
            <Run>贡献：</Run> <Run MouseUp="Run_LGF_github" Style="{DynamicResource RunLink}">@LGF (Github)</Run> <Run MouseUp="Run_LGF_gitee" Style="{DynamicResource RunLink}">@LGF (Gitee)</Run>
            <LineBreak />
            <Run>库引用：</Run> <Run MouseUp="Run_n2n_github" Style="{DynamicResource RunLink}">n2n (github)</Run>
        </TextBlock>

    </Grid>
</Page>
