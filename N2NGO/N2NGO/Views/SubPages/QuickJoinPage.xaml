<Page x:Class="N2NGO.Views.SubPages.QuickJoinPage"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2NGO.Views.SubPages"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified"
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
      Title="Page4">
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="8,18,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label FontSize="24" Padding="0" Margin="5" Foreground="{DynamicResource MainColorSolidFontBrush}" Content="{DynamicResource LOCALE_QuickJoinRoomRoomCode}" Background="{x:Null}" BorderBrush="{x:Null}"/>
            <TextBox x:Name="RoomConnectText" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" MinWidth="210" Height="43" TextBlock.FontSize="14" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" FontSize="24"/>
        </StackPanel>

        <StackPanel x:Name="GroupPasswordInput" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,66,0,0">
            <Label FontSize="20" Padding="0" Margin="5" Foreground="{DynamicResource MainColorSolidFontBrush}" Content="{DynamicResource LOCALE_QuickJoinRoomRoomPassword}" Background="{x:Null}" BorderBrush="{x:Null}"/>
            <TextBox x:Name="RoomPasswordText" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Center" MinWidth="140" TextBlock.FontSize="14" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" Height="33" FontSize="16"/>
        </StackPanel>
        <CheckBox x:Name="IsAuthenticationEnabledCheckbox" Content="{DynamicResource LOCALE_QuickJoinRoomRoomNeedPassword}" Foreground="{DynamicResource MainColorSolidFontBrush}" Background="{DynamicResource MainColorSolidAlphaBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,66" Click="OnIsPasswdNeededCheckboxClick"/>

        <Button Content="{DynamicResource LOCALE_QuickJoinRoomJoin}" Height="61" Width="195" Click="OnJoinButtonClick" FontSize="24" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>

        <Grid x:Name="DialogJoiningRoom" Background="{DynamicResource MainColorSolidAlphaBrush}" Visibility="Collapsed" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <hc:LoadingCircle Foreground="{DynamicResource MainColorSolidFontBrush}" Background="#FFF70000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Label VerticalContentAlignment="Center" Background="{DynamicResource MainColorSolidAlphaBrush}" HorizontalContentAlignment="Center" Content="正在进入房间，请稍后" Foreground="{DynamicResource MainColorSolidFontBrush}" Margin="0,292,0,0" BorderBrush="{x:Null}" VerticalAlignment="Top" Height="39" FontSize="16" />
        </Grid>
    </Grid>
</Page>
