<Page
    x:Class="N2NGO.Views.SubPages.QuickJoinPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.SubPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="Page4"
    d:DesignHeight="{StaticResource PageDesignHeight}"
    d:DesignWidth="{StaticResource PageDesignWidth}"
    FontFamily="{DynamicResource MainFont}"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">
    <Grid>
        <StackPanel
            Margin="8,18,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Label
                Margin="5"
                Padding="0"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                Content="{DynamicResource LOCALE_QuickJoinRoomRoomCode}"
                FontSize="24"
                Foreground="{DynamicResource MainColorSolidFontBrush}" />
            <TextBox
                x:Name="RoomConnectText"
                Height="43"
                MinWidth="210"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource MainColorSolidAlphaBrush}"
                BorderBrush="{x:Null}"
                FontSize="24"
                Foreground="{DynamicResource MainColorSolidFontBrush}"
                TextBlock.FontSize="14"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            x:Name="GroupPasswordInput"
            Margin="10,66,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Label
                Margin="5"
                Padding="0"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                Content="{DynamicResource LOCALE_QuickJoinRoomRoomPassword}"
                FontSize="20"
                Foreground="{DynamicResource MainColorSolidFontBrush}" />
            <TextBox
                x:Name="RoomPasswordText"
                Height="33"
                MinWidth="140"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource MainColorSolidAlphaBrush}"
                BorderBrush="{x:Null}"
                FontSize="16"
                Foreground="{DynamicResource MainColorSolidFontBrush}"
                Text=""
                TextBlock.FontSize="14"
                TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox
            x:Name="IsAuthenticationEnabledCheckbox"
            Margin="0,0,11,66"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource MainColorSolidAlphaBrush}"
            Click="OnIsPasswdNeededCheckboxClick"
            Content="{DynamicResource LOCALE_QuickJoinRoomRoomNeedPassword}"
            FontSize="16"
            Foreground="{DynamicResource MainColorSolidFontBrush}" />

        <Button
            Width="195"
            Height="61"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="OnJoinButtonClick"
            Content="{DynamicResource LOCALE_QuickJoinRoomJoin}"
            FontSize="24" />

        <Grid
            x:Name="DialogJoiningRoom"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource MainColorSolidAlphaBrush}"
            Visibility="Collapsed">
            <hc:LoadingCircle
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFF70000"
                Foreground="{DynamicResource MainColorSolidFontBrush}" />
            <Label
                Height="39"
                Margin="0,292,0,0"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource MainColorSolidAlphaBrush}"
                BorderBrush="{x:Null}"
                Content="正在进入房间，请稍后"
                FontSize="16"
                Foreground="{DynamicResource MainColorSolidFontBrush}" />
        </Grid>
    </Grid>
</Page>
