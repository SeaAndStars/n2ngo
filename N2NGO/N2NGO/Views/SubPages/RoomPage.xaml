<Page x:Class="N2NGO.Views.SubPages.RoomPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:walterlv="clr-namespace:Walterlv.Windows.Effects;assembly=Walterlv.Themes.FluentDesign"
        xmlns:local="clr-namespace:N2NGO.Views.SubPages"
        mc:Ignorable="d"
      TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified"
        d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}"
        Background="{DynamicResource MainColorSolidAlphaBrush}">
    <Grid>
        <Grid Background="{DynamicResource MainColorSolidAlphaBrush}" Height="40" VerticalAlignment="Top">
            <Label VerticalAlignment="Top" Content="当前房间" HorizontalAlignment="Center" Style="{DynamicResource TitleStyle}" VerticalContentAlignment="Center" FontSize="24"/>
            <Button x:Name="ButtonExitRoom" Content="{DynamicResource LOCALE_RoomExitRoomButton}" VerticalAlignment="Top" Click="ButtonExitRoom_Click" Height="40" FontSize="20" HorizontalAlignment="Right" Padding="5,1,5,1"/>
        </Grid>
        <!--<Button x:Name="ButtonRoomRefresh" Content="刷新" VerticalAlignment="Top" Height="40" Width="60" FontSize="20" HorizontalAlignment="Right" Margin="0,0,130,0" Click="ButtonExitRoomRefresh_Click"/>-->

        <Grid Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <Grid Background="{DynamicResource MainColorSolidAlphaBrush}" Margin="10,10,10,10" Grid.Column="0">
            </Grid>

            <Grid Background="{DynamicResource MainColorHighLightSolidAlphaBrush}" Margin="10,10,10,10" Grid.Column="1">
                <hc:ScrollViewer hc:ScrollViewerAttach.Orientation="Vertical" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsControl_Members" Padding="5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Palette_800}" Width="130" Height="38" Margin="2,2,2,4"  MouseEnter="MemberCard_MouseEnter" MouseLeave="MemberCard_MouseLeave" BorderThickness="2">
                                    <Border.BorderBrush>
                                        <walterlv:RevealBorderBrush/>
                                    </Border.BorderBrush>
                                    <Grid x:Name="MemberRootGrid">
                                        <Image Height="18" HorizontalAlignment="Left" IsHitTestVisible="False" VerticalAlignment="Center" Source="/Data/image/Member.png"/>
                                        <Grid x:Name="MemberSubGrid" Margin="20,0,0,0">
                                            <Button x:Name="IpAddressButton" Content="{Binding IpAddress}" Cursor="Hand" Click="IpAddressButton_Click" MinWidth="{Binding Width, ElementName=NicknameLabel}" Initialized="Button_Initialized"/>
                                            <Label x:Name="NicknameLabel" Content="{Binding Nickname}" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <local:RoomPageMemberModel Nickname="AAA Ab" IpAddress="172.16.0.1"/>
                        <local:RoomPageMemberModel Nickname="BBB Bc" IpAddress="172.16.0.2"/>
                        <local:RoomPageMemberModel Nickname="CCC Cd" IpAddress="172.16.0.3"/>
                    </ItemsControl>
                </hc:ScrollViewer>
            </Grid>

            <Border x:Name="tip" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="60" CornerRadius="4" Background="{DynamicResource MainColorHighLightSolidAlphaBrush}" Margin="12,0,12,10" Grid.Row="0">
                <Grid>
                    <TextBlock TextWrapping="Wrap" Padding="3" Text="以您所在的国家地区为准，请勿发布及传播违反当地法律政策的内容" Foreground="{DynamicResource MainColorSolidFontBrush}" FontSize="17"/>
                    <Button x:Name="ButtonKnown" Content="我已了解" VerticalAlignment="Bottom" Height="31" Width="89" Padding="0,0,0,0" Click="ButtonKnown_Click" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
