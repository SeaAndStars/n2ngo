<Page
    x:Class="N2NGO.Views.SubPages.RoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.SubPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:walterlv="clr-namespace:Walterlv.Windows.Effects;assembly=Walterlv.Themes.FluentDesign"
    d:DesignHeight="{StaticResource PageDesignHeight}"
    d:DesignWidth="{StaticResource PageDesignWidth}"
    FontFamily="{DynamicResource MainFont}"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">
    <Page.Resources>
        <local:IsAdminBoolToMemberImageConverter x:Key="IsAdminBoolConverter" />
    </Page.Resources>
    <Grid>
        <Grid
            Height="40"
            VerticalAlignment="Top"
            Background="{DynamicResource Palette_700}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Text="{DynamicResource LOCALE_CurrentRoom}" />
        </Grid>
        <!--<Button x:Name="ButtonRoomRefresh" Content="刷新" VerticalAlignment="Top" Height="40" Width="60" FontSize="20" HorizontalAlignment="Right" Margin="0,0,130,0" Click="ButtonExitRoomRefresh_Click"/>-->

        <Grid Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0.5*" />
            </Grid.ColumnDefinitions>

            <!--  Room Functions  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Margin="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Rectangle
                                Grid.ColumnSpan="2"
                                Effect="{StaticResource EffectShadow3}"
                                Fill="{DynamicResource Palette_500}" />

                            <Grid Grid.Column="0">
                                <TextBlock Margin="6,8,6,8" VerticalAlignment="Top">
                                    <hc:WaveProgressBar
                                        x:Name="ProgressBarRoomLifetime"
                                        Background="{DynamicResource Palette_50}"
                                        BorderBrush="{DynamicResource Palette_50}"
                                        ShowText="False"
                                        WaveFill="{DynamicResource Palette_300}"
                                        Value="50" />
                                    <LineBreak />
                                    <Run Text="{DynamicResource LOCALE_PageRoom-CurrentRoomLifetime}" />
                                    <Run Text=": " />
                                    <Run x:Name="LifetimeValueText" Text="30 min." />
                                </TextBlock>
                                <Button
                                    x:Name="ButtonSwitchAdminPanel"
                                    Margin="6,133,6,10"
                                    HorizontalAlignment="Center"
                                    Click="ButtonSwitchAdminPanel_Click"
                                    Content="{DynamicResource LOCALE_PageRoom-AdminPanelButton_Content}"
                                    Visibility="Visible" />
                            </Grid>

                            <Grid Grid.Column="1">
                                <TextBlock
                                    Padding="5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource Palette_700}"
                                    Foreground="{DynamicResource Palette_100}"
                                    TextWrapping="Wrap">
                                    <Run
                                        x:Name="CurrentRoomName"
                                        FontSize="16"
                                        Text="{DynamicResource LOCALE_Unknown}" />
                                    <LineBreak />
                                    <TextBlock
                                        Margin="5"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Foreground="{DynamicResource Palette_100}"
                                        TextWrapping="Wrap">
                                        <Run
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Palette_50}"
                                            Text="{DynamicResource LOCALE_CurrentRoomCode}" />
                                        <Run
                                            x:Name="CurrentRoomCode"
                                            FontSize="14"
                                            Text="abcdef" />
                                        <LineBreak />
                                        <Run
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Palette_50}"
                                            Text="{DynamicResource LOCALE_CurrentRoomPasswordNeeded}" />
                                        <Run
                                            x:Name="CurrentRoomPasswordNeeded"
                                            FontSize="14"
                                            Text="{DynamicResource LOCALE_CurrentRoomPasswordNeeded_No}" />
                                        <LineBreak />
                                        <Run
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Palette_50}"
                                            Text="{DynamicResource LOCALE_CurrentRoomVisibility}" />
                                        <Run
                                            x:Name="CurrentRoomVisibility"
                                            FontSize="14"
                                            Text="{DynamicResource LOCALE_CurrentRoomVisibility_Invisible}" />
                                        <LineBreak />
                                    </TextBlock>
                                    <LineBreak />
                                    <Run FontSize="12" Text="{DynamicResource LOCALE_CreateRoomMyIP}" />
                                    <Run
                                        x:Name="CurrentRoomIpAddress"
                                        FontSize="16"
                                        Text="{DynamicResource LOCALE_Unknown}" />
                                    <LineBreak />
                                </TextBlock>
                            </Grid>

                        </Grid>
                    </Border>
                    <Border
                        x:Name="PanelAdminControl"
                        Grid.Column="0"
                        RenderTransformOrigin="0,0.5">
                        <Border.LayoutTransform>
                            <ScaleTransform ScaleX="1" />
                        </Border.LayoutTransform>

                        <!--  Panel Control for Administrators of Current Room  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <Rectangle
                                Grid.ColumnSpan="3"
                                Effect="{StaticResource EffectShadow3}"
                                Fill="{DynamicResource Palette_800}" />

                            <Grid Grid.Column="0" Background="{DynamicResource Palette_400}">
                                <Button
                                    x:Name="ButtonAdminActivateRoom"
                                    Margin="0,28,0,0"
                                    Click="ButtonAdminActivateRoom_Click"
                                    Content="{DynamicResource LOCALE_PageRoom-AdminActivateRoomButton_Content}" />
                                <Button
                                    x:Name="ButtonAdminCloseRoom"
                                    Click="ButtonAdminCloseRoom_Click"
                                    Content="{DynamicResource LOCALE_PageRoom-AdminCloseRoomButton_Content}" />
                            </Grid>
                            <TabControl
                                Grid.Column="1"
                                Padding="5,2,5,2"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Palette_600}"
                                BorderBrush="{x:Null}"
                                Style="{StaticResource BaseStyle}">
                                <TabControl.Resources>
                                    <SolidColorBrush x:Key="RegionBrush" Color="Transparent" />
                                </TabControl.Resources>

                                <TabItem Header="{DynamicResource LOCALE_PageRoom-AdminTabMembersHeader_Content}" ToolTip="{DynamicResource LOCALE_PageRoom-AdminTabMembersHeaderTooltip_Content}">
                                    <Grid x:Name="AdminPanelMembers">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <ItemsControl
                                                x:Name="AdminMembersList"
                                                Padding="3"
                                                Background="{DynamicResource Palette_400}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock HorizontalAlignment="Stretch" Background="{DynamicResource Palette_500}">
                                                            <Run Text="[" />
                                                            <Run Text="{Binding ID}" />
                                                            <Run Text="]" />
                                                            <Run Text="{Binding Nickname}" />
                                                            <Run Text="{Binding IpAddress}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>

                                                <local:RoomPageMemberModel />
                                            </ItemsControl>
                                        </Grid>
                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource Palette_500}"
                                            Orientation="Horizontal">
                                            <Button
                                                x:Name="ButtonAdminKick"
                                                Click="ButtonAdminKick_Click"
                                                Content="{DynamicResource LOCALE_PageRoom-AdminKickButton_Content}" />
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="{DynamicResource LOCALE_PageRoom-AdminTabRuledMembersHeader_Content}" ToolTip="{DynamicResource LOCALE_PageRoom-AdminTabMembersRuledHeaderTooltip_Content}">
                                    <Grid x:Name="AdminPanelRuledMembers">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <ItemsControl
                                                x:Name="AdminRuledMembersList"
                                                Padding="3"
                                                Background="{DynamicResource Palette_400}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock HorizontalAlignment="Stretch" Background="{DynamicResource Palette_500}">
                                                            <Run Text="{Binding ID}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>

                                                <local:RoomPageRuledMemberModel />
                                            </ItemsControl>
                                        </Grid>

                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource Palette_500}"
                                            Orientation="Horizontal">
                                            <Button
                                                x:Name="ButtonAdminRuleMemberNone"
                                                Margin="2"
                                                Click="ButtonAdminRuleMemberNone_Click"
                                                Content="{DynamicResource LOCALE_PageRoom-AdminRuleMemberNoneButton_Content}" />
                                            <Button
                                                x:Name="ButtonAdminRuleMemberAllow"
                                                Margin="2"
                                                Click="ButtonAdminRuleMemberAllow_Click"
                                                Content="{DynamicResource LOCALE_PageRoom-AdminRuleMemberAllowButton_Content}" />
                                            <Button
                                                x:Name="ButtonAdminRuleMemberPrevent"
                                                Margin="2"
                                                Click="ButtonAdminRuleMemberPrevent_Click"
                                                Content="{DynamicResource LOCALE_PageRoom-AdminRuleMemberPreventButton_Content}" />
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="8"
                    Background="{DynamicResource Palette_500}" />
            </Grid>

            <Grid
                x:Name="RightPanel"
                Grid.Column="1"
                Margin="10,0,0,0"
                Background="{DynamicResource Palette_400}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    x:Name="ButtonExitRoom"
                    Grid.Row="0"
                    Height="40"
                    Padding="5,1,5,1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="ButtonExitRoom_Click"
                    Content="{DynamicResource LOCALE_RoomExitRoomButton}"
                    FontSize="20" />

                <hc:ScrollViewer
                    Grid.Row="1"
                    hc:ScrollViewerAttach.Orientation="Vertical"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsControl_Members" Padding="5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="130"
                                    Height="38"
                                    Margin="2,2,2,4"
                                    Background="{DynamicResource Palette_500}"
                                    BorderThickness="2"
                                    MouseEnter="MemberCard_MouseEnter"
                                    MouseLeave="MemberCard_MouseLeave">
                                    <Border.BorderBrush>
                                        <walterlv:RevealBorderBrush />
                                    </Border.BorderBrush>
                                    <Grid x:Name="MemberRootGrid">
                                        <Image
                                            Height="18"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Source="{Binding IsAdmin, Converter={StaticResource IsAdminBoolConverter}, Mode=OneWay}" />
                                        <Grid x:Name="MemberSubGrid" Margin="20,0,0,0">
                                            <Button
                                                x:Name="IpAddressButton"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Click="IpAddressButton_Click"
                                                Content="{Binding IpAddress}"
                                                Cursor="Hand"
                                                Initialized="IpAddressButton_Initialized" />
                                            <Grid
                                                x:Name="NicknameLabel"
                                                Width="106"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="{DynamicResource Palette_400}"
                                                IsHitTestVisible="False">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Text="{Binding Nickname}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    FontSize="10"
                                                    Text="{Binding PingLatency}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <local:RoomPageMemberModel
                            IpAddress="172.16.0.1"
                            IsAdmin="False"
                            Nickname="Admin"
                            PingLatency="0ms" />
                        <local:RoomPageMemberModel
                            IpAddress="172.16.0.2"
                            IsAdmin="false"
                            Nickname="Guest1"
                            PingLatency="10ms" />
                        <local:RoomPageMemberModel
                            IpAddress="172.16.0.3"
                            IsAdmin="false"
                            Nickname="Guest2"
                            PingLatency="20ms" />
                    </ItemsControl>
                </hc:ScrollViewer>
            </Grid>

            <Border
                x:Name="tip"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Height="60"
                Margin="12,0,12,10"
                VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="97*" />
                        <ColumnDefinition Width="122*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Grid.ColumnSpan="2"
                        Effect="{StaticResource EffectShadow3}"
                        Fill="{DynamicResource MainColorHighLightSolidAlphaBrush}" />
                    <TextBlock
                        Grid.ColumnSpan="2"
                        Padding="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        FontSize="17"
                        Foreground="{DynamicResource MainColorSolidFontBrush}"
                        Text="{DynamicResource LOCALE_Text_Policy}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ButtonKnown"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Click="ButtonKnown_Click"
                        Content="{DynamicResource LOCALE_IUndertand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
