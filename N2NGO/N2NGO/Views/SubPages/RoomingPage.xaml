<Page x:Class="N2NGO.Views.SubPages.RoomingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2NGO.Views.SubPages"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d"
      TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified"
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
      Title="Page2">
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,16,0,0" VerticalAlignment="Top" >
            <Label FontSize="24" Padding="0" Margin="5" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" Background="{x:Null}" ScrollViewer.CanContentScroll="True" Content="{DynamicResource LOCALE_CreateRoomRoomName}"/>
            <TextBox x:Name="RoomNameInput" TextWrapping="Wrap" MinWidth="283" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" Height="42" FontSize="22"/>
        </StackPanel>

        <StackPanel x:Name="GroupPasswordInput" Orientation="Horizontal" Margin="8,59,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label FontSize="20" Padding="0" Margin="5" Foreground="{DynamicResource MainColorSolidFontBrush}" Content="{DynamicResource LOCALE_CreateRoomRoomPassword}" Background="{x:Null}" BorderBrush="{x:Null}"/>
            <TextBox x:Name="RoomPasswordInput" TextWrapping="Wrap" MinWidth="200" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" Height="42" FontSize="18"/>
        </StackPanel>

        <StackPanel x:Name="GroupInitialLifetimeInput" Orientation="Horizontal" Margin="8,106,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label FontSize="20" Padding="0" Margin="5" Foreground="{DynamicResource MainColorSolidFontBrush}" Content="{DynamicResource LOCALE_CreateRoomRoomInitialLifetime}" Background="{x:Null}" BorderBrush="{x:Null}"/>
            <TextBox x:Name="RoomInitialLifetimeInput" Text="00:10:00" TextWrapping="Wrap" MinWidth="80" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" Height="28" FontSize="16"/>
        </StackPanel>

        <Button x:Name="SetMain" Content="{DynamicResource LOCALE_CreateRoomSetMain}" Margin="8,153,0,0" Height="34" Width="132" Click="SetMain_Click"/>
        <Button x:Name="SetMinor" Content="{DynamicResource LOCALE_CreateRoomSetMinor}" Margin="145,153,0,0" Height="34" Width="132"  Click="SetMinor_Click"/>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Height="263" Width="395" Margin="435,17,0,0" BorderThickness="1" Background="{DynamicResource MainColorSolidAlphaBrush}" BorderBrush="{DynamicResource MainColorSolidForeBrush}">
            <Grid>
                <TextBlock Text="{DynamicResource LOCALE_CreateRoomPreview}" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{DynamicResource Palette_50}" FontSize="18"/>

                <Border x:Name="Root" Width="220" Height="140" CornerRadius="5" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Canvas x:Name="PreviewMinorColor" Opacity="0.37" CacheMode="BitmapCache" Background="{Binding}">
                            <Canvas.DataContext>
                                <SolidColorBrush Color="#F5DEB3"/>
                            </Canvas.DataContext>
                        </Canvas>
                        <TextBlock Margin="5,35,5,5" Foreground="{DynamicResource Palette_400}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Run Text="{DynamicResource LOCALE_CurrentRoomCode}" FontSize="16"/>
                                    <Run Text="abc123" FontSize="18"/>
                                    <LineBreak/>
                                    <Run Text="{Binding IsRoomPasswordNeededText, Mode=OneTime}" FontSize="15"/>
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource Palette_300}" Margin="0,35,5,0">
                                    <Run FontSize="16" Text="0"/>
                                    <Image Height="12" Source="/Data/Images/Members.png"/>
                        </TextBlock>

                        <TextBlock x:Name="PreviewMainColor" Text="{Binding Text, ElementName=RoomNameInput}" Background="{Binding}" FontSize="20" Foreground="{DynamicResource Palette_50}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Padding="3">
                            <TextBlock.DataContext>
                                <SolidColorBrush Color="#6495ED"/>
                            </TextBlock.DataContext>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <CheckBox x:Name="CheckIsRoomPasswordNeeded" Content="{DynamicResource LOCALE_CreateRoomNeedPassword}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource MainColorSolidFontBrush}" Background="{DynamicResource MainColorSolidAlphaBrush}" FontSize="18" Click="CheckIsRoomPasswordNeeded_Click" Margin="0,0,11,88" IsChecked="False"/>
        <CheckBox x:Name="CheckIsRoomInvisible" Content="{DynamicResource LOCALE_CreateRoomInvisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource MainColorSolidFontBrush}" Background="{DynamicResource MainColorSolidAlphaBrush}" FontSize="18" Margin="0,0,11,56" IsChecked="True"/>

        <Button x:Name="ButtonCreateRoom" Content="{DynamicResource LOCALE_CreateRoomCreate}" HorizontalAlignment="Right" Height="51" Width="189" Click="ButtonCreateRoom_Click" VerticalAlignment="Bottom" FontSize="24"/>
    </Grid>
</Page>
