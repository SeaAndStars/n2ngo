<Page x:Class="N2NGO.Views.SubPages.RoomingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2NGO.Views.SubPages"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d"
      TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified"
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
      Title="Page2">
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,16,0,0" VerticalAlignment="Top" >
            <Label FontSize="24" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" Background="{x:Null}" Padding="0,0,0,0" ScrollViewer.CanContentScroll="True" Content="{DynamicResource LOCALE_CreateRoomRoomName}" Margin="0,0,8,0"/>
            <TextBox x:Name="RoomNameInput" TextWrapping="Wrap" MinWidth="283" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" Height="42" FontSize="22"/>
        </StackPanel>

        <StackPanel x:Name="GroupPasswordInput" Orientation="Horizontal" Margin="8,59,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label FontSize="20" Foreground="{DynamicResource MainColorSolidFontBrush}" Content="{DynamicResource LOCALE_CreateRoomRoomPassword}" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0,0,0,0" Margin="0,0,8,0"/>
            <TextBox x:Name="RoomPasswordInput" TextWrapping="Wrap" MinWidth="200" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" Height="42" FontSize="18"/>
        </StackPanel>

        <Button x:Name="SetMain" HorizontalAlignment="Left" VerticalAlignment="Top" Content="{DynamicResource LOCALE_CreateRoomSetMain}" Margin="10,110,0,0" Height="34" Width="132" Background="#FF4FCC62" Click="SetTheme_Click"/>
        <Button x:Name="SetMinor" HorizontalAlignment="Left" VerticalAlignment="Top" Content="{DynamicResource LOCALE_CreateRoomSetMinor}" Margin="147,110,0,0" Height="34" Width="132" Background="#FFFFCECE" Click="SetMinor_Click"/>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Height="263" Width="395" Margin="435,17,0,0" BorderThickness="1" Background="{DynamicResource MainColorSolidAlphaBrush}" BorderBrush="{DynamicResource MainColorSolidForeBrush}">
            <Grid>
                <Label Content="{DynamicResource LOCALE_CreateRoomPreview}" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorSolidFontBrush}" FontSize="18"/>

                <Border x:Name="Root" Width="220" Height="140" CornerRadius="5" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Canvas Opacity="0.37" CacheMode="BitmapCache" Background="{Binding Background, ElementName=SetMinor}"/>
                        <TextBlock Margin="5,35,5,5" Foreground="{DynamicResource Palette_400}">
                                    <Run Text="{DynamicResource LOCALE_CurrentRoomCode}" FontSize="16"/>
                                    <Run Text="abc123" FontSize="18"/>
                                    <LineBreak/>
                                    <Run Text="{Binding IsRoomPasswordNeededText, Mode=OneTime}" FontSize="15"/>
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource Palette_300}" Margin="0,35,5,0">
                                    <Run FontSize="16" Text="0"/>
                                    <Image Height="12" Source="/Data/image/Members.png"/>
                        </TextBlock>

                        <Label Content="{Binding Text, ElementName=RoomNameInput}" Background="{Binding Background, ElementName=SetMain}" FontSize="20" BorderBrush="{x:Null}" Foreground="{DynamicResource Palette_50}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Padding="0,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <CheckBox x:Name="CheckIsRoomPasswordNeeded" Content="{DynamicResource LOCALE_CreateRoomNeedPassword}" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextBlock.FontSize="14" Foreground="{DynamicResource MainColorSolidFontBrush}" Background="{DynamicResource MainColorSolidAlphaBrush}" FontSize="18" Click="CheckIsRoomPasswordNeeded_Click" Margin="0,0,11,88"/>
        <CheckBox x:Name="CheckIsRoomInvisible" Content="{DynamicResource LOCALE_CreateRoomInvisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextBlock.FontSize="14" Foreground="{DynamicResource MainColorSolidFontBrush}" Background="{DynamicResource MainColorSolidAlphaBrush}" FontSize="18" Margin="0,0,11,56"/>

        <Button x:Name="ButtonCreateRoom" Content="{DynamicResource LOCALE_CreateRoomCreate}" HorizontalAlignment="Right" Height="51" Width="189" Click="ButtonCreateRoom_Click" VerticalAlignment="Bottom" FontSize="24"/>
        <!--Button x:Name="ButtonCloseRoom" Style="{StaticResource ButtonDanger}" Content="关闭房间" HorizontalAlignment="Left" Margin="393,300,0,0" Height="40" Width="115" Click="ButtonCloseRoom_Click" TextBlock.FontSize="14" VerticalAlignment="Top"/-->
    </Grid>
</Page>
