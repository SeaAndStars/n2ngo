<Page
    x:Class="N2NGO.Views.SubPages.RoomingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views.SubPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="Page2"
    d:DesignHeight="{StaticResource PageDesignHeight}"
    d:DesignWidth="{StaticResource PageDesignWidth}"
    FontFamily="{DynamicResource MainFont}"
    RenderOptions.BitmapScalingMode="HighQuality"
    RenderOptions.EdgeMode="Unspecified"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">
    <Grid>
        <StackPanel
            Margin="8,16,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Label
                Margin="5"
                Padding="0"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                Content="{DynamicResource LOCALE_CreateRoomRoomName}"
                FontSize="24"
                Foreground="{DynamicResource MainColorSolidFontBrush}"
                ScrollViewer.CanContentScroll="True" />
            <TextBox
                x:Name="RoomNameInput"
                Height="42"
                MinWidth="283"
                Background="{DynamicResource MainColorSolidAlphaBrush}"
                BorderBrush="{x:Null}"
                FontSize="22"
                Foreground="{DynamicResource MainColorSolidFontBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            x:Name="GroupPasswordInput"
            Margin="8,59,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Label
                Margin="5"
                Padding="0"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                Content="{DynamicResource LOCALE_CreateRoomRoomPassword}"
                FontSize="20"
                Foreground="{DynamicResource MainColorSolidFontBrush}" />
            <TextBox
                x:Name="RoomPasswordInput"
                Height="42"
                MinWidth="200"
                Background="{DynamicResource MainColorSolidAlphaBrush}"
                BorderBrush="{x:Null}"
                FontSize="18"
                Foreground="{DynamicResource MainColorSolidFontBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            x:Name="GroupInitialLifetimeInput"
            Margin="8,106,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Label
                Margin="5"
                Padding="0"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                Content="{DynamicResource LOCALE_CreateRoomRoomInitialLifetime}"
                FontSize="20"
                Foreground="{DynamicResource MainColorSolidFontBrush}" />
            <TextBox
                x:Name="RoomInitialLifetimeInput"
                Height="28"
                MinWidth="80"
                Background="{DynamicResource MainColorSolidAlphaBrush}"
                BorderBrush="{x:Null}"
                FontSize="16"
                Foreground="{DynamicResource MainColorSolidFontBrush}"
                Text="00:10:00"
                TextWrapping="Wrap" />
        </StackPanel>

        <Button
            x:Name="SetMain"
            Width="132"
            Height="34"
            Margin="8,153,0,0"
            Click="SetMain_Click"
            Content="{DynamicResource LOCALE_CreateRoomSetMain}" />
        <Button
            x:Name="SetMinor"
            Width="132"
            Height="34"
            Margin="145,153,0,0"
            Click="SetMinor_Click"
            Content="{DynamicResource LOCALE_CreateRoomSetMinor}" />

        <Border
            Width="395"
            Height="263"
            Margin="435,17,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{DynamicResource MainColorSolidAlphaBrush}"
            BorderBrush="{DynamicResource MainColorSolidForeBrush}"
            BorderThickness="1">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="18"
                    Foreground="{DynamicResource Palette_50}"
                    Text="{DynamicResource LOCALE_CreateRoomPreview}" />

                <Border
                    x:Name="Root"
                    Width="220"
                    Height="140"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="5"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </Border.RenderTransform>
                    <Grid>
                        <Canvas
                            x:Name="PreviewMinorColor"
                            Background="{Binding}"
                            CacheMode="BitmapCache"
                            Opacity="0.37">
                            <Canvas.DataContext>
                                <SolidColorBrush Color="#F5DEB3" />
                            </Canvas.DataContext>
                        </Canvas>
                        <TextBlock
                            Margin="5,35,5,5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Foreground="{DynamicResource Palette_400}">
                            <Run FontSize="16" Text="{DynamicResource LOCALE_CurrentRoomCode}" />
                            <Run FontSize="18" Text="abc123" />
                            <LineBreak />
                            <Run FontSize="15" Text="{Binding IsRoomPasswordNeededText, Mode=OneTime}" />
                        </TextBlock>

                        <TextBlock
                            Margin="0,35,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource Palette_300}">
                            <Run FontSize="16" Text="0" />
                            <Image Height="12" Source="/Data/Images/Members.png" />
                        </TextBlock>

                        <TextBlock
                            x:Name="PreviewMainColor"
                            Padding="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="{Binding}"
                            FontSize="20"
                            Foreground="{DynamicResource Palette_50}"
                            Text="{Binding Text, ElementName=RoomNameInput}">
                            <TextBlock.DataContext>
                                <SolidColorBrush Color="#6495ED" />
                            </TextBlock.DataContext>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <CheckBox
            x:Name="CheckIsRoomPasswordNeeded"
            Margin="0,0,11,88"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource MainColorSolidAlphaBrush}"
            Click="CheckIsRoomPasswordNeeded_Click"
            Content="{DynamicResource LOCALE_CreateRoomNeedPassword}"
            FontSize="18"
            Foreground="{DynamicResource MainColorSolidFontBrush}"
            IsChecked="False" />
        <CheckBox
            x:Name="CheckIsRoomInvisible"
            Margin="0,0,11,56"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource MainColorSolidAlphaBrush}"
            Content="{DynamicResource LOCALE_CreateRoomInvisible}"
            FontSize="18"
            Foreground="{DynamicResource MainColorSolidFontBrush}"
            IsChecked="True" />

        <Button
            x:Name="ButtonCreateRoom"
            Width="189"
            Height="51"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="ButtonCreateRoom_Click"
            Content="{DynamicResource LOCALE_CreateRoomCreate}"
            FontSize="24" />
    </Grid>
</Page>
