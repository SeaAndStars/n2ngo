<Window
    x:Class="N2NGO.Views.TerminalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:N2NGO.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    x:Name="WindowTerminal"
    Title="TerminalWindow"
    Width="960"
    Height="640"
    Background="#BF272727"
    Closing="WindowTerminal_Closing"
    Foreground="#FFE2E2E2"
    Icon="/Data/Images/N2N GO Debug.png"
    MouseWheel="WindowTerminal_MouseWheel"
    TextOptions.TextFormattingMode="Display"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  @https://learn.microsoft.com/en-us/dotnet/api/system.windows.controls.primitives.textboxbase.isundoenabled?view=windowsdesktop-8.0 "Setting this property to clears the undo stack. Therefore, if you disable undo and then re-enable it, undo commands still do not work because the undo stack was emptied when you disabled undo.false"  -->
        <TextBox
            x:Name="TerminalView"
            Grid.Row="0"
            Padding="2,2,2,2"
            VerticalContentAlignment="Top"
            Background="{x:Null}"
            BorderBrush="{x:Null}"
            FontFamily="{DynamicResource MonoTerminalFont}"
            FontSize="18"
            Foreground="Gainsboro"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            IsUndoEnabled="False"
            SelectionBrush="White"
            Text="Hello, World!"
            VerticalScrollBarVisibility="Visible">
            <TextBox.Resources>
                <!--  Brushes for scrollview bar  -->
                <SolidColorBrush x:Key="PrimaryTextBrush" Color="GhostWhite" />
                <SolidColorBrush x:Key="SecondaryTextBrush" Color="White" />
            </TextBox.Resources>
        </TextBox>
        <Grid Grid.Row="1" Background="#FF312D31">
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="ButtonClearBuffer"
                    Padding="5"
                    Background="#FF464242"
                    Click="ButtonClearBuffer_Click"
                    Content="Clear Buffer"
                    FontSize="14"
                    Foreground="WhiteSmoke" />

                <CheckBox
                    x:Name="CheckBoxScrollToEnd"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    FontSize="14"
                    Foreground="WhiteSmoke"
                    IsChecked="True">
                    Scroll-To-End
                </CheckBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
