<local1:BaseIndexPage x:Class="N2Nmc.Views.SubPages.IndexPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages"
      xmlns:local1="clr-namespace:N2Nmc.UtilsClass"
      mc:Ignorable="d" 
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
      Title="IndexPage" Loaded="Page_Loaded">
    <Grid>
        <hc:ScrollViewer hc:ScrollViewerAttach.Orientation="Horizontal" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Indexers" Margin="8,15,8,15" >
                <ItemsControl.Resources>
                    <local1:IndexerTextConverter x:Key="IndexerTextConverter"/>
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemMainParent" Margin="5" Width="240" Height="500"  Background="#5FB3B3B3" CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
            Initialized="TempGrid_Initialized" MouseEnter="TempGrid_MouseEnter" MouseLeave="TempGrid_MouseLeave" MouseDown="TempGrid_MouseDown" MouseUp="TempGrid_MouseUp" MouseLeftButtonUp="TempGrid_MouseLeftButtonUp">
                            <Grid x:Name="TempGrid">
                                <Image Name="ContentBackgroundImage" Opacity="0.5" Source="{Binding IndexerCBI}" Stretch="UniformToFill" Margin="25,250,0,0"/>
                                <TextBlock Margin="5" Foreground="{DynamicResource MainColorSolidFontBrush}" TextWrapping="Wrap">
                                    <Run Name="_dynamicTextIndexerTitle" Text="{Binding IndexerTitle}" FontWeight="Bold" FontSize="34"/>
                                    <LineBreak/>
                                    <Run Name="_dynamicTextIndexerDescription" Text="{Binding IndexerDescription}" FontSize="16" Foreground="#FF313131"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
                <Border x:Name="ItemMainParent" Margin="5" Width="240" Height="500"  Background="#5FB3B3B3" CornerRadius="{DynamicResource CornerRadiusCornerRadius}"
Initialized="TempGrid_Initialized" MouseEnter="TempGrid_MouseEnter" MouseLeave="TempGrid_MouseLeave" MouseDown="TempGrid_MouseDown" MouseUp="TempGrid_MouseUp" MouseLeftButtonUp="TempGrid_MouseLeftButtonUp">
                    <Grid x:Name="TempGrid">
                        <TextBlock Margin="5" Foreground="{DynamicResource MainColorSolidFontBrush}" TextWrapping="Wrap">
                        <Run Name="_dynamicTextIndexerTitle" Text="A" FontWeight="Bold" FontSize="34"/>
                        <LineBreak/>
                        <Run Name="_dynamicTextIndexerDescription" Text="B" FontSize="16" Foreground="#FF313131"/>
                        </TextBlock>
                    </Grid>
                </Border>
                <local1:Indexer nagivKey="community"  IndexerTitle="@LOCALE_Index-Community_Title" IndexerDescription="@LOCALE_Index-Community_Description" IndexerCBI="/Data/image/Community.png"/>
                <local1:Indexer nagivKey="hosting" IndexerTitle="@LOCALE_Index-Hosting_Title" IndexerDescription="@LOCALE_Index-Hosting_Description" IndexerCBI="/Data/image/Hosting.png"/>
                <local1:Indexer nagivKey="clienting" IndexerTitle="@LOCALE_Index-Clienting_Title" IndexerDescription="@LOCALE_Index-Clienting_Description" IndexerCBI="/Data/image/Clienting.png"/>
                <local1:Indexer nagivKey="advanced" IndexerTitle="@LOCALE_Index-Advanced_Title" IndexerDescription="@LOCALE_Index-Advanced_Description" IndexerCBI="/Data/image/Advanced.png"/>
                <local1:Indexer nagivKey="about" IndexerTitle="@LOCALE_Index-About_Title" IndexerDescription="@LOCALE_Index-About_Description" IndexerCBI="/Data/image/About.png"/>
            </ItemsControl>
        </hc:ScrollViewer>
    </Grid>
</local1:BaseIndexPage>
