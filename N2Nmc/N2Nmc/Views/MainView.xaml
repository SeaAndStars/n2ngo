<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N2Nmc"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:hc1="https://handyorg.github.io/handycontrol" x:Class="N2Nmc.Views.MainView"
        mc:Ignorable="d"
        Title="N2Nmc" Height="570" Width="930" WindowStartupLocation="CenterScreen" Icon="/Data/image/logo13.ico" WindowStyle="None" AllowsTransparency="True" Background="{DynamicResource MainColorDarkSolidAlphaBrush}" Loaded="Window_Loaded" Closing="Window_Closing">
    <!--MouseMove="Window_MouseMove"-->

    <Border Margin="0">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--内容-->
            <Border CornerRadius="0,0,0,0" Grid.Row="1">
                <Grid>
                    <Grid.Resources>
                        <Style x:Key="BButtonStyle" TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="#0fd3d3d3" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="hc:Poptip.Content" Value="{Binding Tag, RelativeSource={RelativeSource Mode=Self}}" />
                        </Style>

                        <Style x:Key="BBButtonStyle" TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="#0fd3d3d3" />
                            <Setter Property="Margin" Value="10,3,10,3" />
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="hc:Poptip.Content" Value="{Binding Tag, RelativeSource={RelativeSource Mode=Self}}" />
                        </Style>

                        <Style x:Key="ItemAccessTextStyle" TargetType="{x:Type AccessText}">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="60,0,10,0"/>
                            <Setter Property="Foreground" Value="WhiteSmoke"/>
                            <Setter Property="FontSize" Value="16"/>
                        </Style>

                    </Grid.Resources>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 主内容区域 -->
                    <!--Image x:Name="ImageBackgroundImage" Source="/Data/image/ai.png" Grid.Column="1" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.6" ScaleY="1.6"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Frame x:Name="Cover" Background="#AAf5f6f7" Grid.Column="1"/>-->

                    <Grid x:Name="FramezGrid" Grid.Column="1">
                        <Frame x:Name="Framez" NavigationUIVisibility="Hidden" BorderBrush="{x:Null}">
                            <Frame.Effect>
                                <BlurEffect x:Name="BlurFramez" Radius="5"/>
                            </Frame.Effect>
                        </Frame>
                        <Frame x:Name="FrameOverlay" Visibility="Collapsed" BorderBrush="{x:Null}" Foreground="{x:Null}">
                            <Frame.Background>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#66000000"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Frame.Background>
                        </Frame>
                    </Grid>

                    <hc:SimpleStackPanel x:Name="PanelMsg" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="1"/>

                    <!-- 左侧边栏 -->
                    <Grid Name="GridLeft" MouseEnter="GridLeft_MouseEnter" MouseLeave="GridLeft_MouseLeave" Width="65" HorizontalAlignment="Left" Grid.Column="0" Background="{DynamicResource MainColorDarkSolidAlphaBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="Buttons1" Grid.Row="0">
                            <Border x:Name="RootPageBtn" Style="{StaticResource BButtonStyle}" Height="60" MouseUp="RootPageBtn_Click">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Data/image/icon/root.png" Height="45" Width="45" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Style="{StaticResource ImageRenderEdge}" />
                                    <AccessText Text="主页" Style="{StaticResource ItemAccessTextStyle}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="ButtonRooms" Style="{StaticResource BButtonStyle}" Height="60" MouseUp="ButtonRooms_Click">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Data/image/icon/rooms.png" Height="45" Width="45" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Style="{StaticResource ImageRenderEdge}" />
                                    <AccessText Text="大厅" Style="{StaticResource ItemAccessTextStyle}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="ButtonRooming" Style="{StaticResource BButtonStyle}" MouseUp="ButtonRooming_Click" Height="60">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Data/image/icon/rooming.png" Height="45" Width="45" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Style="{StaticResource ImageRenderEdge}" />
                                    <AccessText Text="创建" Style="{StaticResource ItemAccessTextStyle}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="ButtonQuickJoin" Style="{StaticResource BButtonStyle}" MouseUp="ButtonQuickJoin_Click" Height="60">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Data/image/icon/join.png" Height="45" Width="45" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Style="{StaticResource ImageRenderEdge}" />
                                    <AccessText Text="快速加入" Style="{StaticResource ItemAccessTextStyle}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="ButtonRoom" Style="{StaticResource BButtonStyle}" MouseUp="ButtonRoom_Click" Height="180">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Data/image/icon/room.png" Height="Auto" Width="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Style="{StaticResource ImageRenderEdge}" />
                                    <!--AccessText Text="房间" Style="{StaticResource ItemAccessTextStyle}"/-->
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="Buttons2" Background="#1A101010" Grid.Row="1">
                            <Border x:Name="ButtonSettings" Style="{StaticResource BBButtonStyle}" hc:Poptip.Content="设置" MouseUp="ButtonSettings_Click" Height="40" >
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Data/image/icon/settings.png" Height="20" Width="20" Style="{StaticResource ImageRenderEdge}" />
                                </Grid>
                            </Border>
                            <Border x:Name="ButtonLog" Style="{StaticResource BBButtonStyle}" hc:Poptip.Content="日志" MouseUp="ButtonLog_Click" Height="40">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Data/image/icon/log.png" Height="20" Width="20" Style="{StaticResource ImageRenderEdge}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Image x:Name="PageIndicator" Source="/Data/image/ind.png" Width="10" Height="60" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-400,0,0" Grid.RowSpan="5" Opacity="0.5">
                            <Image.Effect>
                                <DropShadowEffect Opacity="0.25" Color="#FFD8D8D8"/>
                            </Image.Effect>
                        </Image>
                    </Grid>
                </Grid>
            </Border>

            <!--标题栏-->
            <Border x:Name="TitleBorder" MouseLeftButtonDown="WinMove_main" Grid.Row="0" Background="{DynamicResource MainColorDarkAlphaBrush}">
                <Grid x:Name="grid" Height="40" VerticalAlignment="Top">
                    <!--<Border MouseLeftButtonDown=""></Border>-->
                    <Label x:Name="LabelTitle" Content="     N2Nmc     " Style="{StaticResource TitleStyle}" />
                    <Button x:Name="ButtonClose" Style="{StaticResource TitleButtonStyle}" Margin="0,0,0,0" Click="ButtonClose_Click">
                        <Border>
                            <Path Data="M1 0 20 20M1 20 20 0" Stroke="{DynamicResource MainColorDarkSolidFontBrush}" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Button x:Name="ButtonWindowMin" Style="{StaticResource TitleButtonStyle}" Margin="0,0,55,0" Click="ButtonWindowMin_Click">
                        <Border>
                            <Path Data="M2 10 H18" Stroke="{DynamicResource MainColorDarkSolidFontBrush}" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <!--开屏动画-->
            <Border Grid.RowSpan="5" Background="White" Visibility="Collapsed">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                </ObjectAnimationUsingKeyFrames>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            To="Transparent"
                            Duration="0:0:0.85" BeginTime="0:0:2" />
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:2.85" Value="{x:Static Visibility.Collapsed}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Image Source="/Data/image/logo13.ico" Stretch="None">
                    <Image.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1" Duration="0:0:0.5" />
                                    <DoubleAnimation
                                Storyboard.TargetProperty="Opacity"
                                From="1" To="0" Duration="0:0:0.5" BeginTime="0:0:1" />
                                    <!--ObjectAnimationUsingKeyFrames
                            Storyboard.TargetProperty="Source">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:3" Value="" />
                                    </ObjectAnimationUsingKeyFrames-->
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Image.Triggers>
                </Image>
            </Border>


        </Grid>
    </Border>
</Window>
