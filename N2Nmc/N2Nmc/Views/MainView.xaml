<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N2Nmc"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:hc1="https://handyorg.github.io/handycontrol" xmlns:system="clr-namespace:System;assembly=netstandard" x:Class="N2Nmc.Views.MainView"
        mc:Ignorable="d"
        Title="N2Nmc" Height="570" Width="930"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Animated" RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.EdgeMode="Aliased" WindowStartupLocation="CenterScreen" Icon="/Data/image/logo13.ico" WindowStyle="None" AllowsTransparency="True" Loaded="Window_Loaded" Closing="Window_Closing" FontFamily="{DynamicResource MainFont}" Background="Transparent" StateChanged="Window_StateChanged">
    <Window.RenderTransform>
        <ScaleTransform />
    </Window.RenderTransform>
    <Border x:Name="RootControl" Background="{x:Null}">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--内容-->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="AUTO"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 主内容区域 -->
                <!--Image x:Name="ImageBackgroundImage" Source="/Data/image/ai.png" Grid.Column="1" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.6" ScaleY="1.6"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Frame x:Name="Cover" Background="#AAf5f6f7" Grid.Column="1"/>-->

                <Grid x:Name="FramezGrid" Grid.Column="1">
                    <Frame x:Name="Framez" NavigationUIVisibility="Hidden" BorderBrush="{x:Null}"/>
                    <Frame x:Name="FrameOverlay" Visibility="Collapsed" BorderBrush="{x:Null}" Foreground="{x:Null}">
                        <Frame.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#66000000"/>
                                <GradientStop Color="White" Offset="1"/>
                            </LinearGradientBrush>
                        </Frame.Background>
                    </Frame>
                </Grid>

                <hc:SimpleStackPanel x:Name="PanelMsg" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="1"/>

            </Grid>

            <!-- 消息对话框集合 -->
            <Grid x:Name="MessageDialogs" Grid.Row="1"/>

            <!--标题栏-->
            <Border x:Name="TitleBorder" MouseLeftButtonDown="WinMove_main" Grid.Row="0" Background="{DynamicResource MainColorSolidAlphaBrush}">
                <Grid x:Name="grid" Height="40" VerticalAlignment="Top">
                    <TextBlock>
                        <Button Width="40" Height="35" Padding="0" Background="Transparent" BorderBrush="{x:Null}" Margin="0,2,0,0" Click="ButtonBack_Click">
                            <Image x:Name="LBImage_Wnd_Btn_Back" Width="35" Height="35" Stretch="Fill" Source="/Data/image/icon/wnd_btn_back.png" />
                        </Button>
                        <Button Width="40" Height="35" Padding="0" Background="Transparent" BorderBrush="{x:Null}" Margin="0,2,0,0" Click="TitleIconButton_Click">
                            <Image Width="35" Height="35" Stretch="Fill" />
                        </Button>
                    </TextBlock>
                    <Label x:Name="LabelTitle" Content="     N2N GO     " Style="{StaticResource TitleStyle}" />
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <StackPanel.Resources>
                            <Style TargetType="Image">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="FlowDirection" Value="LeftToRight"/>
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="ButtonClose" Style="{StaticResource ButtonStyle}" Width="55" Click="ButtonClose_Click">
                            <Image x:Name="LBImage_Wnd_Btn_Close" Source="/Data/image/icon/wnd_btn_close.png" Width="25"/>
                        </Button>
                        <Button x:Name="ButtonWindowMaxNormal" Style="{StaticResource ButtonStyle}" Width="55" Click="ButtonWindowMaxNormal_Click">
                            <Image x:Name="LBImage_Wnd_Btn_MaxNormal" Source="/Data/image/icon/wnd_btn_normal.png" Width="25"/>
                        </Button>
                        <Button x:Name="ButtonWindowMin" Style="{StaticResource ButtonStyle}" Width="55" Click="ButtonWindowMin_Click">
                            <Image x:Name="LBImage_Wnd_Btn_Min" Source="/Data/image/icon/wnd_btn_min.png" Width="25"/>
                        </Button>
                        <Button x:Name="ButtonWindowColorSwitch" Style="{StaticResource ButtonStyle}" Click="ButtonWindowColorSwitch_Click" Width="35">
                            <Image x:Name="LBImage_DayNight" Source="/Data/image/icon/daynight.png"/>
                        </Button>
                        <!--<Button x:Name="ButtonLog" Style="{StaticResource ButtonStyle}" Margin="0,0,155,0" Click="ButtonLog_Click" Width="35">
                        <Image x:Name="LBImage_Log" Source="/Data/image/icon/log.png" Height="20" Width="20"/>
                    </Button>-->
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
