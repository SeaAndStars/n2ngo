<Page x:Class="N2Nmc.Views.SubPages.DefaultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages"
      mc:Ignorable="d" 
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}"
      Title="DefaultPage">
    <Grid>
        <Label Background="{DynamicResource MainColorDarkSolidAlphaBrush}" Height="192" Width="442" Content="Hi! 欢迎！这里是n2nMc起始页面，请从左侧开始！" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" FontSize="16" HorizontalAlignment="Left" Margin="413,10,0,0" VerticalAlignment="Top" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"/>

        <TextBox x:Name="NewsOfflineBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource MainColorDarkSolidAlphaBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="455" Width="398" Margin="10,10,0,0" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"/>
        <Label x:Name="LabelVersion" Content="当前版本：" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" MouseDoubleClick="LabelVersion_MouseDoubleClick" Background="{DynamicResource MainColorDarkSolidAlphaBrush}" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"/>
        <Button x:Name="ButtonUpdate" Background="{StaticResource MainColorDarkSolidBrush}" Content="检查更新" HorizontalAlignment="Right" Margin="0,490,10,0" VerticalAlignment="Top" Click="ButtonUpdate_Click" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"/>
    </Grid>
</Page>
