<Page x:Class="N2Nmc.Views.SubPages.Dialogs.DialogMessage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages.Dialogs"
      mc:Ignorable="d" 
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
      Title="DialogMessage" Loaded="Page_Loaded" Foreground="{DynamicResource MainColorSolidFontBrush}">
    <Grid>
        <Border x:Name="ContentBackground" Width="400" Height="250" Effect="{StaticResource EffectShadow4}" CacheMode="BitmapCache" Background="{DynamicResource MainColorSolidAlphaBrush}" />
        <Grid x:Name="ContentGrid" Width="400" Height="250" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Background="{DynamicResource Palette_700}">
                <Label x:Name="MessageTitle" Height="38" Foreground="{DynamicResource MainColorSolidForeBrush}" BorderBrush="{x:Null}" Background="{x:Null}" HorizontalAlignment="Stretch" FontSize="20"/>
            </Grid>

            <Frame x:Name="ContentPresenter" Grid.Row="1" >
            </Frame>
        </Grid>
    </Grid>
</Page>
