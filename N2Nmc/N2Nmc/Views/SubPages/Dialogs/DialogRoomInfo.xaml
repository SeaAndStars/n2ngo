<Page
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N2Nmc.Views.SubPages.Dialogs"
        xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="N2Nmc.Views.SubPages.Dialogs.DialogRoomInfo"
        mc:Ignorable="d"
        Title="DialogRoomInfo" Height="360" Width="280" Background="{DynamicResource MainColorSolidAlphaBrush}" RenderTransformOrigin="0.5,0.5" FontFamily="{DynamicResource MainFont}" Loaded="Page_Loaded">
    <Grid x:Name="grid">
        <Label x:Name="RoomTitle" Content="Room" VerticalAlignment="Top" Background="{DynamicResource MainColorHighLightSolidAlphaBrush}" BorderBrush="{x:Null}" FontSize="14" Foreground="{DynamicResource MainColorSolidFontBrush}"/>
        <TextBox x:Name="RoomInfo" IsReadOnly="True" Background="{DynamicResource MainColorSolidAlphaBrush}" Margin="10,54,10,110" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontSize="13" Foreground="{DynamicResource MainColorSolidFontBrush}" SelectionBrush="{DynamicResource MainColorHighLightSolidAlphaBrush}" BorderBrush="{x:Null}"/>

        <Grid x:Name="GroupPassword" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource MainColorSolidFontBrush}"><Run Text="密码"/></TextBlock>
            <TextBox x:Name="TextBoxPasswd" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" SelectionBrush="{DynamicResource MainColorHighLightSolidAlphaBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="29,0,0,0" Width="144" BorderBrush="{x:Null}"/>
        </Grid>

        <Button x:Name="ButtonCancel" Style="{DynamicResource ButtonStyle}" Content="取消" VerticalAlignment="Bottom" Margin="0,0,8,45" Width="75" HorizontalAlignment="Right" Height="28" />
        <Button x:Name="FuncButton" Style="{DynamicResource ButtonStyle}" Content="Function" VerticalAlignment="Bottom" Margin="0,0,8,10" Width="79" Height="30" HorizontalAlignment="Right" />
    </Grid>
</Page>
