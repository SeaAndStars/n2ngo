<Page
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N2Nmc.Views.SubPages.Dialogs"
        xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="N2Nmc.Views.SubPages.Dialogs.DialogRoomInfo"
        mc:Ignorable="d"
        Title="DialogRoomInfo" Height="360" Width="280" RenderTransformOrigin="0.5,0.5" Loaded="Page_Loaded">
    <Border BorderBrush="White" BorderThickness="2" CornerRadius="8" Background="{DynamicResource MainColorDarkSolidAlphaBrush}">
        <Grid x:Name="grid">
            <Grid.Background>
                <ImageBrush ImageSource="/Data/image/logo13.ico" Stretch="None" Opacity="0.25"/>
            </Grid.Background>
            <Label x:Name="RoomTitle" Content="Room" VerticalAlignment="Top" Background="{DynamicResource MainColorDarkHighLightSolidAlphaBrush}" BorderBrush="{x:Null}" FontSize="14" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"/>
            <TextBox x:Name="RoomInfo" IsReadOnly="True" Background="{DynamicResource MainColorDarkSolidAlphaBrush}" Margin="10,54,10,110" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontSize="13" Foreground="{DynamicResource MainColorDarkSolidFontBrush}" SelectionBrush="{DynamicResource MainColorDarkHighLightSolidAlphaBrush}" BorderBrush="{x:Null}"/>

            <Grid x:Name="GroupPassword" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"><Run Text="密码"/></TextBlock>
                <TextBox x:Name="TextBoxPasswd" Background="{DynamicResource MainColorDarkSolidAlphaBrush}" Foreground="{DynamicResource MainColorDarkSolidFontBrush}" SelectionBrush="{DynamicResource MainColorDarkHighLightSolidAlphaBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="29,0,0,0" Width="144"/>
            </Grid>

            <Button x:Name="ButtonCancel" Content="取消" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,45" Background="{DynamicResource MainColorDarkSolidAlphaBrush}" Foreground="{DynamicResource MainColorDarkSolidFontBrush}" />
            <Button x:Name="FuncButton" Content="Function" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,10" Background="{DynamicResource MainColorDarkSolidAlphaBrush}" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"  />
        </Grid>
    </Border>
</Page>
