<Page x:Class="N2Nmc.Views.SubPages.Dialogs.MessageDialogs.DialogInput"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages.Dialogs.MessageDialogs"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="YesNo"  Foreground="{DynamicResource MainColorSolidFontBrush}">

    <Grid Margin="5,0,5,0">
        <TextBlock x:Name="MessageContentRunner" TextWrapping="Wrap" Margin="0,0,0,110" FontSize="17.5" Padding="5,2,5,0" Background="{DynamicResource MainColorSolidAlphaBrush}"/>

        <TextBox x:Name="InputBox" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource MainColorSolidAlphaBrush}" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorSolidFontBrush}" FontSize="20" Height="44" HorizontalContentAlignment="Center" MinWidth="120" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,60" Padding="10,6,13,6" />
        <Button x:Name="ButtonOK" Style="{DynamicResource ButtonStyle}" Width="90" VerticalAlignment="Bottom" Content="OK" HorizontalAlignment="Center" FontSize="18" Height="36" Margin="0,0,0,20"/>
    </Grid>
</Page>
