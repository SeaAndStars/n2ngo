<Page x:Class="N2Nmc.Views.SubPages.Dialogs.MessageDialogs.DialogOK"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages.Dialogs.MessageDialogs"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OK" Foreground="{DynamicResource MainColorSolidFontBrush}">

    <Grid>
        <TextBlock x:Name="MessageContentRunner" TextWrapping="Wrap" Margin="0,0,0,65" FontSize="17.5" Padding="5,2,5,0" />
        <Button x:Name="ButtonOK" Width="90" VerticalAlignment="Bottom" Content="OK" HorizontalAlignment="Center" FontSize="18" Height="36" Margin="0,0,0,20"/>
    </Grid>
</Page>
