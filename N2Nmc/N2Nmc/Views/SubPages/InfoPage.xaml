<Page x:Class="N2Nmc.Views.SubPages.InfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages"
      mc:Ignorable="d" 
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
      Title="InfoPage">
    <Grid>
        <Canvas x:Name="N2NGO_Warpper_C">
            <Image x:Name="N2NGO_Warpper" Source="/Data/image/N2NGO_Logo_Warpper.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="865"/>
        </Canvas>
        <Canvas x:Name="N2NGO_N2N_Border_C">
            <Image x:Name="N2NGO_N2N_Border" Source="/Data/image/N2NGO_Logo_N2N_Border.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="865"/>
        </Canvas>
        <Canvas x:Name="N2NGO_N2N_C" >
            <Image x:Name="N2NGO_N2N" Source="/Data/image/N2NGO_Logo_N2N.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="865"/>
        </Canvas>
        <Canvas x:Name="N2NGO_GO_C" >
            <Image x:Name="N2NGO_GO" Source="/Data/image/N2NGO_Logo_GO.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="865"/>
        </Canvas>

        <TextBlock x:Name="N2NGO_base" Margin="0,10,0,0" VerticalAlignment="Top" Height="92" Width="844">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="1,0" StartPoint="0,1">
                    <GradientStop Color="#FF484848" Offset="0"/>
                    <GradientStop Color="White" Offset="1"/>
                    <GradientStop Color="White" Offset="0.74"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
            
            <Run FontSize="68">N2N GO</Run>
            <Run FontSize="10">Ver. 4.0.0</Run>
        </TextBlock>

        <TextBlock x:Name="N2NGO_Link" Margin="33,107,33,118" FontSize="18">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="1,0" StartPoint="0,1">
                    <GradientStop Color="#FF484848" Offset="1"/>
                    <GradientStop Color="White" Offset="0"/>
                    <GradientStop Color="White" Offset="0.26"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
            <Run>GPL3.0</Run> 
            <Image Source="/Data/image/logo13.ico" Width="15"/> <Run Style="{DynamicResource RunLink}" MouseUp="Run_N2NGO_gitee" Text="https://gitee.com/xue-jiangbin/n2nmc"/>
            <LineBreak/>
        </TextBlock>

        <TextBlock x:Name="N2NGO_info" VerticalAlignment="Bottom" Height="87" Width="843" Background="{DynamicResource MainColorSolidAlphaBrush}" FontSize="18" Margin="11,0,11,0" Foreground="{DynamicResource MainColorSolidFontBrush}" Padding="5,5,5,5" >
            <Run>始创：</Run> <Run MouseUp="Run_未来之乡_gitee" Style="{DynamicResource RunLink}">@未来之乡 (Gitee)</Run> 
                <LineBreak/>
            <Run>贡献：</Run> <Run MouseUp="Run_LGF_github" Style="{DynamicResource RunLink}">@LGF (Github)</Run> <Run MouseUp="Run_LGF_gitee" Style="{DynamicResource RunLink}">@LGF (Gitee)</Run> 
                <LineBreak/>
            <Run>库引用：</Run> <Run MouseUp="Run_n2n_github" Style="{DynamicResource RunLink}">n2n (github)</Run>
        </TextBlock>

    </Grid>
</Page>
