<Page x:Class="N2Nmc.Views.SubPages.QuickJoinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
      Title="Page4">
    <Grid>
        <Label HorizontalAlignment="Left" Margin="8,18,0,0"  VerticalAlignment="Top" FontSize="24" Foreground="{DynamicResource MainColorSolidFontBrush}" Content="代码" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" Height="34"/>
        <TextBox x:Name="RoomConnectText" HorizontalAlignment="Left" Margin="63,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210" Height="51" TextBlock.FontSize="14" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" FontSize="24"/>

        <Canvas x:Name="GroupPasswordInput" HorizontalAlignment="Left" VerticalAlignment="Top" Height="166" Width="436" Margin="10,66,0,0">
            <Label HorizontalAlignment="Left" FontSize="20" Foreground="{DynamicResource MainColorSolidFontBrush}" Canvas.Top="2" Content="密码" Padding="0" Background="{x:Null}" BorderBrush="{x:Null}" Canvas.Left="6"/>
            <TextBox x:Name="RoomPasswordText" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="177" TextBlock.FontSize="14" Background="{DynamicResource MainColorSolidAlphaBrush}" Foreground="{DynamicResource MainColorSolidFontBrush}" BorderBrush="{x:Null}" Height="33" FontSize="16" Canvas.Left="53" />
        </Canvas>
        <CheckBox x:Name="CheckIsPasswdNeeded" Content="需要密码" TextBlock.FontSize="14" Foreground="{DynamicResource MainColorSolidFontBrush}" Background="{DynamicResource MainColorSolidAlphaBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,66" Click="CheckIsPasswdNeeded_Click"/>

        <Button Content="快速进入" Style="{StaticResource ButtonStyle}" Height="61" Width="195" Click="Button_Click" TextBlock.FontSize="14" FontSize="24" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
        
        <hc:SimpleStackPanel x:Name="PanelMsg" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </Grid>
</Page>
