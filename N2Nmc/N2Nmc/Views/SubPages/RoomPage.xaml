<Page x:Class="N2Nmc.Views.SubPages.RoomPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N2Nmc.Views"
        mc:Ignorable="d"
        d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}"
        Background="{DynamicResource MainColorDarkSolidAlphaBrush}">
    <Grid>
        <Label Height="40" VerticalAlignment="Top" Content="房间列表" HorizontalAlignment="Center" Style="{StaticResource TitleStyle}" VerticalContentAlignment="Center"/>
        <Button x:Name="ButtonExitRoom" Background="{DynamicResource MainColorDarkHighLightSolidAlphaBrush}" Content="退出房间" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource MainColorDarkSolidFontBrush}" Click="ButtonExitRoom_Click"/>

        <Grid Background="{DynamicResource MainColorDarkSolidAlphaBrush}" Margin="0,40,0,0">
            <DataGrid x:Name="DataGridroom" Style="{StaticResource DataGrid.Small}"  IsReadOnly="True" AutoGenerateColumns="False" Grid.Row="0" AllowDrop="True" Background="{DynamicResource MainColorDarkSolidDarkAlphaBrush}" Margin="10,10,10,10" Foreground="{DynamicResource MainColorDarkSolidFontBrush}" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="编号" Binding="{Binding StuIda}" Width="50"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Community}"/>
                    <DataGridTextColumn Header="IP"  Binding="{Binding Ip4Address}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="tip" VerticalAlignment="Bottom" Height="52" CornerRadius="4" Background="{DynamicResource MainColorDarkHighLightSolidAlphaBrush}" Margin="12,0,12,10" Grid.Row="0">
                <Grid>
                    <TextBlock TextWrapping="Wrap" Text="请直接使用 直接连接 加入游戏。" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"/>
                    <Button x:Name="ButtonKnown" Background="{StaticResource MainColorDarkSolidBrush}" Content="我已了解" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="25" Width="64" Padding="0,0,0,0" Click="ButtonKnown_Click" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
