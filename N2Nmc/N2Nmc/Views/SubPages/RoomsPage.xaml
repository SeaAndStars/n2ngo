<Page x:Class="N2Nmc.Views.SubPages.RoomsPage"
      
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}"
      Title="Page1">
    <Grid x:Name="grid">
        <hc:ScrollViewer VirtualizingStackPanel.IsVirtualizing="True"  VerticalScrollBarVisibility="Auto" IsInertiaEnabled="True" Width="865" Height="530">
            <ScrollViewer.Effect>
                <BlurEffect x:Name="MainBlur" Radius="0"/>
            </ScrollViewer.Effect>

            <ItemsControl x:Name="Cards" Margin="0,35,0,0" >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="TempGrid" Margin="5" Width="200" Height="120" Background="#5FFFFFFF" MouseEnter="TempGrid_MouseEnter" MouseLeave="TempGrid_MouseLeave" MouseDown="TempGrid_MouseDown" MouseUp="TempGrid_MouseUp" RenderTransformOrigin="0.5,0.5" Initialized="TempGrid_Initialized" MouseLeftButtonUp="TempGrid_MouseLeftButtonUp">
                            <TextBlock Margin="5" Foreground="{DynamicResource MainColorDarkSolidFontBrush}">
                                <Run Text="{Binding RoomName}" FontSize="17.5"/>
                                <LineBreak/>
                                <Run Text="房间号 " FontSize="13" Foreground="#FF313131"/>
                                <Run Text="{Binding RoomCode}" FontSize="12" Foreground="#FF373737"/>
                                <LineBreak/>
                                <Run Text="{Binding IsRoomPasswordNeededText, Mode=OneTime}" FontSize="12" Foreground="#FF373737"/>
                            </TextBlock>
                            <Button x:Name="ButtonJoin" Background="{StaticResource MainColorDarkSolidBrush}" Content="{Binding BtnText}" Margin="0,0,5,5" Click="ButtonJoin_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource MainColorDarkSolidFontBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <local:Card RoomName="aaa" BtnText="测试"/>
            </ItemsControl>
        </hc:ScrollViewer>

        <Border x:Name="CardDialogBorder" Visibility="Collapsed" Background="{DynamicResource MainColorDarkAlphaBrush}">
            <Frame x:Name="CardDialogBorderFrame" BorderBrush="{x:Null}"/>
        </Border>

        <Border Background="{DynamicResource MainColorDarkSolidAlphaBrush}" VerticalAlignment="Top" Height="35" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Column="2" >
                    <Button x:Name="ButtonRefresh" Content=" 刷新 " HorizontalAlignment="Right" Click="ButtonRefresh_Click" Margin="0,0,5,0" BorderBrush="White" Background="{StaticResource MainColorDarkSolidBrush}" Foreground="White" />
                    <!--ToggleButton x:Name="SwitchFakeServer" Style="{StaticResource ToggleButtonBaseStyle}" Content="虚拟列表" Background="{StaticResource MainColorDarkSolidBrush}" HorizontalAlignment="Center" Checked="SwitchFakeServer_Checked" Unchecked="SwitchFakeServer_Unchecked" Initialized="SwitchFakeServer_Initialized"/-->

                </StackPanel>

                <hc:SearchBar x:Name="RoomsSearching" hc:InfoElement.ShowClearButton="True" hc:InfoElement.Placeholder="过滤 (空格分隔关键字) (支持房间号和房间名)" Style="{StaticResource SearchBarPlus}" Grid.Column="1" Margin="5,2,5,2" SearchStarted="RoomsSearching_SearchStarted" TextChanged="RoomsSearching_TextChanged" Background="{DynamicResource MainColorDarkSolidAlphaBrush}" Foreground="{DynamicResource MainColorDarkSolidFontBrush}" SelectionBrush="{DynamicResource MainColorDarkHighLightSolidAlphaBrush}"/>
            </Grid>
        </Border>

        <Grid x:Name="DialogLoadingRooms" Background="{StaticResource MainColorDarkSolidAlphaBrush}" Visibility="Collapsed" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="{Binding Height, ElementName=grid}">
            <hc:LoadingCircle Foreground="{StaticResource MainColorDarkSolidBrush}" Background="#FFF70000"/>
            <Button x:Name="ButtonCancelLoadingRooms" Background="{StaticResource MainColorDarkSolidAlphaBrush}" Content="取消加载"  Margin="10,0,0,10" VerticalAlignment="Bottom" BorderBrush="#FFE0E0E0" HorizontalAlignment="Left" Foreground="White" Click="ButtonCancelLoadingRooms_Click" />
            <Label VerticalContentAlignment="Center" Background="{StaticResource MainColorDarkSolidAlphaBrush}" HorizontalContentAlignment="Center" Content="加载中，请稍后" Foreground="White" Margin="0,85,0,0" BorderBrush="{x:Null}" />
        </Grid>

        <hc:SimpleStackPanel x:Name="PanelMsg" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </Grid>

</Page>
