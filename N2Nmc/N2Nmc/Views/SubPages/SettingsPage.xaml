<Page x:Class="N2Nmc.Views.SubPages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
      Title="Page6">
    <Grid>
        <hc:ComboBox x:Name="ColorPaletteSeletion" HorizontalAlignment="Center" VerticalAlignment="Top" Height="43" Width="326" Margin="0,134,0,0" SelectedIndex="0" ItemsSource="{DynamicResource BuiltinColorPaletteNames}" SelectionChanged="ColorPaletteSeletion_SelectionChanged"/>
        <!--Button x:Name="SelectBackgroundImageButton" FontSize="14" Background="{StaticResource MainColorSolidBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,19,0,0" Height="40" Width="125" Content="选取背景图片" Foreground="White" Click="SelectBackgroundImageButton_Click" /-->
        <Button x:Name="InstallTapButton" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,182,0,0" Height="43" Width="326" Content="安装Tap驱动" Click="InstallTapButton_Click" />
        <Button x:Name="ClearShaderCacheButton" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,230,0,0" Height="43" Width="326" Content="清除着色器缓存" Click="ClearShaderCacheButton_Click" />
        <Label x:Name="OSliderInd" Margin="0,318,0,0" VerticalAlignment="Top" Width="326" Content="背景不透明度" FontSize="16" Height="35" HorizontalContentAlignment="Center" Padding="150,0,0,0"/>
        <Slider x:Name="BackgroundOSlider" Value="50" Minimum="0" Maximum="255" Background="{DynamicResource MainColorBrush}" ValueChanged="BackgroundOSlider_ValueChanged" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,326,145,0" Width="149"/>

        <Button x:Name="ResetConfigButton" Content="重置设置" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,375,0,0" Width="284" Height="36" Click="ResetConfigButton_Click"/>
    </Grid>
</Page>
