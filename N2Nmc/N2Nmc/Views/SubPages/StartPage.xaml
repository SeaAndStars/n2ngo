<Page x:Class="N2Nmc.Views.SubPages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:N2Nmc.Views.SubPages"
      mc:Ignorable="d" 
      d:DesignHeight="{StaticResource PageDesignHeight}" d:DesignWidth="{StaticResource PageDesignWidth}" FontFamily="{DynamicResource MainFont}"
      Title="DefaultPage">
    <Grid>
        <Label Background="{DynamicResource MainColorSolidAlphaBrush}" Height="192" Content="Hi! 欢迎！这里是N2N GO起始页面，请从左侧开始！" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" FontSize="18" HorizontalAlignment="Stretch" Margin="413,10,10,0" VerticalAlignment="Top" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorSolidFontBrush}"/>

        <!--TextBox x:Name="NewsOfflineBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource MainColorSolidAlphaBrush}" HorizontalAlignment="Left" Width="398" Margin="10,10,0,10" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorSolidFontBrush}" FontSize="20"/-->
        <Label x:Name="LabelOnlineTotal" Background="{DynamicResource MainColorSolidAlphaBrush}" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorSolidFontBrush}" HorizontalAlignment="Left" Margin="132,10,0,0" VerticalAlignment="Top" Width="154" Content="当前 0人在线"/>
        <TextBox x:Name="ForumBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource MainColorSolidAlphaBrush}" HorizontalAlignment="Left" Width="398" Margin="10,45,0,54" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorSolidFontBrush}" FontSize="20" VerticalContentAlignment="Top"/>
        <TextBox x:Name="ForumCommitBox" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource MainColorSolidAlphaBrush}" HorizontalAlignment="Left" Width="335" Margin="10,0,0,5" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorSolidFontBrush}" FontSize="20" VerticalAlignment="Bottom" Height="44" VerticalContentAlignment="Top"/>
        <Button x:Name="ButtonForumCommit" Content="发送" VerticalAlignment="Bottom" Click="ButtonForumCommit_Click" Height="44" Width="58" HorizontalAlignment="Left" Margin="350,0,0,5"/>

        <Label x:Name="LabelVersion" Content="当前版本：" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="413,207,10,0" MouseDoubleClick="LabelVersion_MouseDoubleClick" Background="{DynamicResource MainColorSolidAlphaBrush}" BorderBrush="{x:Null}" Foreground="{DynamicResource MainColorSolidFontBrush}" Height="37" FontSize="16"/>
        <Button x:Name="ButtonResetConnection" Content="（调试）重置连接" VerticalAlignment="Bottom" Click="ButtonDebug_ResetConnection_Click" Height="44" Width="165" HorizontalAlignment="Right" Margin="0,0,151,5"/>
        <Button x:Name="ButtonUpdate" Content="检查更新" VerticalAlignment="Bottom" Click="ButtonUpdate_Click" Height="44" Width="141" HorizontalAlignment="Right" Margin="0,0,5,5"/>

    </Grid>
</Page>
